    "html-to-image": "^1.11.13",
    "pitchy": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smplr": "^1.0.0",
    "tonal": "^6.4.3",
    "vexflow": "^5.0.0"
