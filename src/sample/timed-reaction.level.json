{
  "schemaVersion": 1,
  "kind": "level",
  "id": "res_01J9A0A0A0A0A0A0A0A0A0A0A4",
  "version": "1.0.0",
  "meta": {
    "title": "限时反应 · 3 秒作答",
    "description": "每题只有 3 秒！演示隐形 timer 组件的 start/stop/tick 与限时判定。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "练耳",
      "限时",
      "反应"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 3
  },
  "refs": [],
  "content": {
    "components": [
      {
        "id": "scoreLabel",
        "type": "label",
        "name": "得分",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 20,
          "w": 300,
          "h": 40
        },
        "props": {
          "text": "得分: 0"
        }
      },
      {
        "id": "timerLabel",
        "type": "label",
        "name": "倒计时提示",
        "visible": true,
        "layout": {
          "x": 620,
          "y": 20,
          "w": 140,
          "h": 40
        },
        "props": {
          "text": "⏱ 3 秒"
        }
      },
      {
        "id": "choice1",
        "type": "choice",
        "name": "选项组",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 100,
          "w": 720,
          "h": 220
        },
        "props": {},
        "bindings": {
          "options": "$q.data.options"
        }
      },
      {
        "id": "feedback",
        "type": "label",
        "name": "反馈文本",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 350,
          "w": 720,
          "h": 48
        },
        "props": {
          "text": ""
        }
      },
      {
        "id": "listenBtn",
        "type": "button",
        "name": "重听",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 430,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "🔊 重听",
          "enabled": true
        }
      },
      {
        "id": "nextBtn",
        "type": "button",
        "name": "下一题",
        "visible": true,
        "layout": {
          "x": 620,
          "y": 430,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "下一题 →",
          "enabled": false
        }
      },
      {
        "id": "sound1",
        "type": "sound",
        "name": "发声器",
        "visible": false
      },
      {
        "id": "timer1",
        "type": "timer",
        "name": "限时器",
        "visible": false
      }
    ],
    "logic": {
      "variables": {
        "score": 0,
        "done": false
      },
      "rules": [
        {
          "id": "load-question",
          "on": "level.questionLoaded",
          "do": [
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.listenNotes"
              }
            },
            {
              "cmd": "choice1.reset"
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": false
              }
            },
            {
              "cmd": "timer1.start",
              "args": {
                "ms": 3000
              }
            },
            {
              "cmd": "timerLabel.show",
              "args": {
                "text": "⏱ 3 秒",
                "tone": "info"
              }
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "听 —— 3 秒内选出答案！",
                "tone": "info"
              }
            }
          ]
        },
        {
          "id": "replay",
          "on": "listenBtn.clicked",
          "do": [
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.listenNotes"
              }
            }
          ]
        },
        {
          "id": "correct",
          "on": "choice1.chosen",
          "when": [
            "!v.answered",
            "event.index == q.data.correctIndex"
          ],
          "do": [
            {
              "set": "answered",
              "expr": "true"
            },
            {
              "cmd": "timer1.stop"
            },
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.rewardChord"
              }
            },
            {
              "cmd": "choice1.reveal",
              "args": {
                "correctIndex": "$q.data.correctIndex"
              }
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "答对了！",
                "tone": "success"
              }
            },
            {
              "set": "score",
              "expr": "v.score + q.scoring.max"
            },
            {
              "cmd": "scoreLabel.show",
              "args": {
                "text": ":'得分: ' + v.score",
                "tone": "success"
              }
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": true
              }
            }
          ]
        },
        {
          "id": "wrong",
          "on": "choice1.chosen",
          "when": [
            "!v.answered",
            "!(event.index == q.data.correctIndex)"
          ],
          "do": [
            {
              "set": "answered",
              "expr": "true"
            },
            {
              "cmd": "timer1.stop"
            },
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.wrongBuzz"
              }
            },
            {
              "cmd": "choice1.reveal",
              "args": {
                "correctIndex": "$q.data.correctIndex"
              }
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "不对，正确答案已高亮",
                "tone": "error"
              }
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": true
              }
            }
          ]
        },
        {
          "id": "timeout",
          "on": "timer1.tick",
          "do": [
            {
              "set": "answered",
              "expr": "true"
            },
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.wrongBuzz"
              }
            },
            {
              "cmd": "choice1.reveal",
              "args": {
                "correctIndex": "$q.data.correctIndex"
              }
            },
            {
              "cmd": "timerLabel.show",
              "args": {
                "text": "⏱ 超时！",
                "tone": "error"
              }
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "时间到！正确答案已高亮",
                "tone": "error"
              }
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": true
              }
            }
          ],
          "when": [
            "!v.answered"
          ]
        },
        {
          "id": "next-or-restart",
          "on": "nextBtn.clicked",
          "when": [
            "!v.done"
          ],
          "do": [
            {
              "cmd": "level.next"
            }
          ],
          "else": [
            {
              "cmd": "level.restart"
            }
          ]
        },
        {
          "id": "on-finish",
          "on": "level.finished",
          "do": [
            {
              "set": "done",
              "expr": "true"
            },
            {
              "cmd": "timer1.stop"
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "$expr:event.passed ? '完成！得分 ' + v.score + ' 🎉 手够快！' : '完成！得分 ' + v.score + '，再快一点'",
                "tone": "info"
              }
            },
            {
              "cmd": "nextBtn.setText",
              "args": {
                "text": "重新开始"
              }
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": true
              }
            }
          ]
        }
      ]
    },
