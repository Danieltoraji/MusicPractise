{
  "schemaVersion": 3,
  "kind": "level",
  "id": "res_01J9A0A0A0A0A0A0A0A0A0A0A2",
  "version": "1.0.0",
  "meta": {
    "title": "和弦听辨 · 选择题模板",
    "description": "听和弦，从选项中选出名称。演示 choice 组件、reveal 判定展示与选择题模板复用。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "练耳",
      "和弦",
      "选择题"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 2
  },
  "refs": [],
  "content": {
    "components": [
      {
        "id": "scoreLabel",
        "type": "label",
        "name": "得分",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 20,
          "w": 300,
          "h": 40
        },
        "props": {
          "text": "得分: 0"
        },
        "view": "main"
      },
      {
        "id": "choice1",
        "type": "choice",
        "name": "选项组",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 100,
          "w": 720,
          "h": 220
        },
        "props": {},
        "bindings": {
          "options": "$q.data.options"
        },
        "view": "main"
      },
      {
        "id": "feedback",
        "type": "label",
        "name": "反馈文本",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 350,
          "w": 720,
          "h": 48
        },
        "props": {
          "text": ""
        },
        "view": "main"
      },
      {
        "id": "listenBtn",
        "type": "button",
        "name": "重听",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 430,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "🔊 重听",
          "enabled": true
        },
        "view": "main"
      },
      {
        "id": "nextBtn",
        "type": "button",
        "name": "下一题",
        "visible": true,
        "layout": {
          "x": 620,
          "y": 430,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "下一题 →",
          "enabled": false
        },
        "view": "main"
      },
      {
        "id": "sound1",
        "type": "sound",
        "name": "发声器",
        "visible": false,
        "view": "main"
      }
    ],
    "logic": {
      "logicVersion": 2,
      "variables": {
        "score": 0,
        "done": false
      },
      "nodes": [
        {
          "id": "load-question_on",
          "kind": "on",
          "event": "level.questionLoaded"
        },
        {
          "id": "load-question_d0",
          "kind": "call",
          "target": "sound1",
          "method": "play",
          "args": [
            "{notes: q.data.listenNotes}"
          ]
        },
        {
          "id": "load-question_d1",
          "kind": "call",
          "target": "choice1",
          "method": "reset",
          "args": []
        },
        {
          "id": "load-question_d2",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: false}"
          ]
        },
        {
          "id": "load-question_d3",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: '听和弦 —— 它是什么三和弦？', tone: 'info'}"
          ]
        },
        {
          "id": "replay_on",
          "kind": "on",
          "event": "listenBtn.clicked"
        },
        {
          "id": "replay_d0",
          "kind": "call",
          "target": "sound1",
          "method": "play",
          "args": [
            "{notes: q.data.listenNotes}"
          ]
        },
        {
          "id": "check-answer_on",
          "kind": "on",
          "event": "choice1.chosen"
        },
        {
          "id": "check-answer_cond",
          "kind": "branch",
          "cond": "(event.index == q.data.correctIndex)"
        },
        {
          "id": "check-answer_d0",
          "kind": "call",
          "target": "sound1",
          "method": "play",
          "args": [
            "{notes: q.data.rewardChord}"
          ]
        },
        {
          "id": "check-answer_d1",
          "kind": "call",
          "target": "choice1",
          "method": "reveal",
          "args": [
            "{correctIndex: q.data.correctIndex}"
          ]
        },
        {
          "id": "check-answer_d2",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: '答对了！', tone: 'success'}"
          ]
        },
        {
          "id": "check-answer_d3",
          "kind": "assign",
          "target": "score",
          "value": {
            "expr": "v.score + q.scoring.max"
          }
        },
        {
          "id": "check-answer_d4",
          "kind": "call",
          "target": "scoreLabel",
          "method": "show",
          "args": [
            "{text: '得分: ' + v.score, tone: 'success'}"
          ]
        },
        {
          "id": "check-answer_d5",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: true}"
          ]
        },
        {
          "id": "check-answer_e0",
          "kind": "call",
          "target": "sound1",
          "method": "play",
          "args": [
            "{notes: q.data.wrongBuzz}"
          ]
        },
        {
          "id": "check-answer_e1",
          "kind": "call",
          "target": "choice1",
          "method": "reveal",
          "args": [
            "{correctIndex: q.data.correctIndex}"
          ]
        },
        {
          "id": "check-answer_e2",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: '不对，正确答案已高亮，进入下一题', tone: 'error'}"
          ]
        },
        {
          "id": "check-answer_e3",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: true}"
          ]
        },
        {
          "id": "next-or-restart_on",
          "kind": "on",
          "event": "nextBtn.clicked"
        },
        {
          "id": "next-or-restart_cond",
          "kind": "branch",
          "cond": "(!v.done)"
        },
        {
          "id": "next-or-restart_d0",
          "kind": "call",
          "target": "level",
          "method": "next",
          "args": []
        },
        {
          "id": "next-or-restart_e0",
          "kind": "call",
          "target": "level",
          "method": "restart",
          "args": []
        },
        {
          "id": "on-finish_on",
          "kind": "on",
          "event": "level.finished"
        },
        {
          "id": "on-finish_d0",
          "kind": "assign",
          "target": "done",
          "value": {
            "expr": "true"
          }
        },
        {
          "id": "on-finish_d1",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: event.passed ? '完成！得分 ' + v.score + ' 🎉' : '完成！得分 ' + v.score + '，再练一次', tone: 'info'}"
          ]
        },
        {
          "id": "on-finish_d2",
          "kind": "call",
          "target": "nextBtn",
          "method": "setText",
          "args": [
            "{text: '重新开始'}"
          ]
        },
        {
          "id": "on-finish_d3",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: true}"
          ]
        }
      ],
      "edges": [
        {
          "id": "m1",
          "from": "load-question_d0",
          "to": "load-question_d1"
        },
        {
          "id": "m2",
          "from": "load-question_d1",
          "to": "load-question_d2"
        },
        {
          "id": "m3",
          "from": "load-question_d2",
          "to": "load-question_d3"
        },
        {
          "id": "m4",
          "from": "load-question_on",
          "to": "load-question_d0"
        },
        {
          "id": "m5",
          "from": "replay_on",
          "to": "replay_d0"
        },
        {
          "id": "m6",
          "from": "check-answer_on",
          "to": "check-answer_cond"
        },
        {
          "id": "m7",
          "from": "check-answer_d0",
          "to": "check-answer_d1"
        },
        {
          "id": "m8",
          "from": "check-answer_d1",
          "to": "check-answer_d2"
        },
        {
          "id": "m9",
          "from": "check-answer_d2",
          "to": "check-answer_d3"
        },
        {
          "id": "m10",
          "from": "check-answer_d3",
          "to": "check-answer_d4"
        },
        {
          "id": "m11",
          "from": "check-answer_d4",
          "to": "check-answer_d5"
        },
        {
          "id": "m12",
          "from": "check-answer_cond",
          "to": "check-answer_d0",
          "port": "true"
        },
        {
          "id": "m13",
          "from": "check-answer_e0",
          "to": "check-answer_e1"
        },
        {
          "id": "m14",
          "from": "check-answer_e1",
          "to": "check-answer_e2"
        },
        {
          "id": "m15",
          "from": "check-answer_e2",
          "to": "check-answer_e3"
        },
        {
          "id": "m16",
          "from": "check-answer_cond",
          "to": "check-answer_e0",
          "port": "false"
        },
        {
          "id": "m17",
          "from": "next-or-restart_on",
          "to": "next-or-restart_cond"
        },
        {
          "id": "m18",
          "from": "next-or-restart_cond",
          "to": "next-or-restart_d0",
          "port": "true"
        },
        {
          "id": "m19",
          "from": "next-or-restart_cond",
          "to": "next-or-restart_e0",
          "port": "false"
        },
        {
          "id": "m20",
          "from": "on-finish_d0",
          "to": "on-finish_d1"
        },
        {
          "id": "m21",
          "from": "on-finish_d1",
          "to": "on-finish_d2"
        },
        {
          "id": "m22",
          "from": "on-finish_d2",
          "to": "on-finish_d3"
        },
        {
          "id": "m23",
          "from": "on-finish_on",
          "to": "on-finish_d0"
        }
      ]
    },
    "flow": {
      "order": "sequential",
      "count": null,
      "pass": {
        "expr": "v.score >= 10"
      }
    },
