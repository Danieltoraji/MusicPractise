  "meta": {
    "title": "和弦听辨 · 选择题模板",
    "description": "听和弦，从选项中选出名称。演示 choice 组件、reveal 判定展示与选择题模板复用。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "练耳",
      "和弦",
      "选择题"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 2
  },
  "content": {
    "shell": {
      "views": [
        {
          "id": "main",
          "name": "主视图"
        },
        {
          "id": "settled",
          "name": "结算视图"
        }
      ],
      "components": [
        {
          "id": "titleLabel",
          "type": "label",
          "name": "关卡标题",
          "view": "main",
          "layout": {
            "x": 24,
            "y": 12,
            "w": 536,
            "h": 28
          },
          "props": {
            "text": "和弦听辨 · 选择题模板"
          }
        },
        {
          "id": "scoreLabel",
          "type": "label",
          "name": "得分",
          "view": "main",
          "layout": {
            "x": 600,
            "y": 12,
            "w": 176,
            "h": 28
          },
          "bindings": {
            "text": "'得分 ' + v.score"
          }
        },
        {
          "id": "progressLabel",
          "type": "label",
          "name": "进度",
          "view": "main",
          "layout": {
            "x": 24,
            "y": 42,
            "w": 536,
            "h": 24
          },
          "bindings": {
            "text": "'进度 ' + v.row + ' / ' + run.total"
          }
        },
        {
          "id": "settledLabel",
          "type": "label",
          "name": "结算文本",
          "view": "settled",
          "layout": {
            "x": 200,
            "y": 110,
            "w": 400,
            "h": 48
          },
          "bindings": {
            "text": "'本关得分 ' + v.score"
          }
        }
      ]
    },
    "types": [
      {
        "id": "choice-listen",
        "name": "听音选择",
        "surface": {
          "components": [
            {
              "id": "prompt",
              "type": "label",
              "name": "题面",
              "layout": {
                "x": 24,
                "y": 16,
                "w": 552,
                "h": 32
              },
              "bindings": {
                "text": "q.prompt"
              }
            },
            {
              "id": "listenBtn",
              "type": "button",
              "name": "重听",
              "layout": {
                "x": 600,
                "y": 16,
                "w": 176,
                "h": 36
              },
              "props": {
                "text": "🔊 重听"
              }
            },
            {
              "id": "choice1",
              "type": "choice",
              "name": "选项",
              "layout": {
                "x": 24,
                "y": 72,
                "w": 752,
                "h": 240
              }
            },
            {
              "id": "feedback",
              "type": "label",
              "name": "反馈",
              "layout": {
                "x": 24,
                "y": 336,
                "w": 752,
                "h": 40
              },
              "props": {
                "text": ""
              }
            },
            {
              "id": "nextBtn",
              "type": "button",
              "name": "下一题",
              "layout": {
                "x": 600,
                "y": 388,
                "w": 176,
                "h": 44
              },
              "props": {
                "text": "下一题 →"
              }
            },
            {
              "id": "sound1",
              "type": "sound",
              "name": "发声器"
            }
          ]
        },
        "behavior": {
          "logicVersion": 3,
          "kind": "behavior",
          "nodes": [
            {
              "id": "b_onStart",
              "kind": "on",
              "event": "start"
            },
            {
              "id": "b_setOptions",
              "kind": "call",
              "target": "choice1",
              "method": "setOptions",
              "arg": "{ options: q.options }"
            },
            {
              "id": "b_countAsk",
              "kind": "assign",
              "target": "t.asked",
              "value": {
                "expr": "t.asked + 1"
              }
            },
            {
              "id": "b_playListen",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_start_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_start_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring + args.bonus }"
            },
            {
              "id": "b_onReplay",
              "kind": "on",
              "event": "listenBtn.clicked"
            },
            {
              "id": "b_playReplay",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_replay_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_replay_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring + args.bonus }"
            },
            {
              "id": "b_onChosen",
              "kind": "on",
              "event": "choice1.chosen"
            },
            {
              "id": "b_chosen_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_chosen_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring + args.bonus }"
            },
            {
              "id": "b_isCorrect",
              "kind": "branch",
              "cond": "event.payload.index == q.answerIndex"
            },
            {
              "id": "b_markAnswered",
              "kind": "assign",
              "target": "q.state.answered",
              "value": {
                "expr": "true"
              }
            },
            {
              "id": "b_reveal",
              "kind": "call",
              "target": "choice1",
              "method": "reveal",
              "arg": "{ correctIndex: q.answerIndex }"
            },
            {
              "id": "b_feedbackOk",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '答对了！点「下一题」继续。', tone: 'success' }"
            },
            {
              "id": "b_feedbackBad",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '不是这个，再听一遍。', tone: 'error' }"
            },
            {
              "id": "b_onNext",
              "kind": "on",
              "event": "nextBtn.clicked"
            },
            {
              "id": "b_next_next",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_next_next_scored",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring + args.bonus }"
            },
            {
              "id": "b_next_next_skipped",
              "kind": "return",
              "result": "{ status: 'skipped', correct: false, scoreDelta: 0 }"
            },
            {
              "id": "b_comment",
              "kind": "comment",
              "text": "首次答对计分（answered 守卫）；答错只给反馈，可重听重选；下一题收题"
            }
          ],
          "edges": [
            {
              "id": "e_b_onStart_b_setOptions",
              "from": "b_onStart",
              "to": "b_setOptions"
            },
            {
              "id": "e_b_setOptions_b_countAsk",
              "from": "b_setOptions",
              "to": "b_countAsk"
            },
            {
              "id": "e_b_countAsk_b_playListen",
              "from": "b_countAsk",
              "to": "b_playListen"
            },
            {
              "id": "e_b_playListen_b_start_guard",
              "from": "b_playListen",
              "to": "b_start_guard"
            },
            {
              "id": "e_b_start_guard_b_start_guard_ret_true",
              "from": "b_start_guard",
              "to": "b_start_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onReplay_b_playReplay",
              "from": "b_onReplay",
              "to": "b_playReplay"
            },
            {
              "id": "e_b_playReplay_b_replay_guard",
              "from": "b_playReplay",
              "to": "b_replay_guard"
            },
            {
              "id": "e_b_replay_guard_b_replay_guard_ret_true",
              "from": "b_replay_guard",
              "to": "b_replay_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onChosen_b_chosen_guard",
              "from": "b_onChosen",
              "to": "b_chosen_guard"
            },
            {
              "id": "e_b_chosen_guard_b_isCorrect_false",
              "from": "b_chosen_guard",
              "to": "b_isCorrect",
              "port": "false"
            },
            {
              "id": "e_b_chosen_guard_b_chosen_guard_ret_true",
              "from": "b_chosen_guard",
              "to": "b_chosen_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_isCorrect_b_markAnswered_true",
              "from": "b_isCorrect",
              "to": "b_markAnswered",
              "port": "true"
            },
            {
              "id": "e_b_markAnswered_b_reveal",
              "from": "b_markAnswered",
              "to": "b_reveal"
            },
            {
              "id": "e_b_reveal_b_feedbackOk",
              "from": "b_reveal",
              "to": "b_feedbackOk"
            },
            {
              "id": "e_b_isCorrect_b_feedbackBad_false",
              "from": "b_isCorrect",
              "to": "b_feedbackBad",
              "port": "false"
            },
            {
              "id": "e_b_onNext_b_next_next",
              "from": "b_onNext",
              "to": "b_next_next"
            },
            {
              "id": "e_b_next_next_b_next_next_scored_true",
              "from": "b_next_next",
              "to": "b_next_next_scored",
              "port": "true"
            },
            {
              "id": "e_b_next_next_b_next_next_skipped_false",
              "from": "b_next_next",
              "to": "b_next_next_skipped",
              "port": "false"
            }
          ]
        },
        "description": "听音频选择正确选项：演示 choice.options 绑定之外的显式 setOptions 命令、reveal 判定与手动下一题。",
        "state": [
          {
            "key": "answered",
            "type": "boolean",
            "init": false
          }
        ],
        "typeState": [
          {
            "key": "asked",
            "type": "number",
            "init": 0
          }
        ],
        "args": [
          {
            "key": "bonus",
            "type": "number",
            "optional": true,
            "default": 0
          }
        ]
      }
    ],
    "tables": {
