{
  "schemaVersion": 4,
  "kind": "level",
  "id": "res_01J9F0F0F0F0F0F0F0F0F0F0F0",
  "version": "1.0.0",
  "meta": {
    "title": "节奏跟拍",
    "description": "跟随节拍器在圆盘上打拍子，节奏判定全在题型行为里（rhythmScore 表达式函数 + 多轮重试）。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "节奏",
      "跟拍"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 2
  },
  "content": {
    "shell": {
      "views": [
        {
          "id": "main",
          "name": "主视图"
        },
        {
          "id": "settled",
          "name": "结算视图"
        }
      ],
      "components": [
        {
          "id": "titleLabel",
          "type": "label",
          "name": "关卡标题",
          "view": "main",
          "layout": {
            "x": 24,
            "y": 12,
            "w": 536,
            "h": 28
          },
          "props": {
            "text": "节奏跟拍"
          }
        },
        {
          "id": "scoreLabel",
          "type": "label",
          "name": "得分",
          "view": "main",
          "layout": {
            "x": 600,
            "y": 12,
            "w": 176,
            "h": 28
          },
          "bindings": {
            "text": "'得分 ' + v.score"
          }
        },
        {
          "id": "progressLabel",
          "type": "label",
          "name": "进度",
          "view": "main",
          "layout": {
            "x": 24,
            "y": 42,
            "w": 536,
            "h": 24
          },
          "bindings": {
            "text": "'进度 ' + v.row + ' / ' + run.total"
          }
        },
        {
          "id": "settledLabel",
          "type": "label",
          "name": "结算文本",
          "view": "settled",
          "layout": {
            "x": 200,
            "y": 110,
            "w": 400,
            "h": 48
          },
          "bindings": {
            "text": "'本关得分 ' + v.score"
          }
        }
      ]
    },
    "types": [
      {
        "id": "rhythm-tap",
        "name": "节奏跟拍",
        "surface": {
          "components": [
            {
              "id": "prompt",
              "type": "label",
              "name": "题面",
              "layout": {
                "x": 24,
                "y": 16,
                "w": 752,
                "h": 32
              },
              "bindings": {
                "text": "q.prompt"
              }
            },
            {
              "id": "rhythm1",
              "type": "rhythm",
              "name": "节奏盘",
              "layout": {
                "x": 180,
                "y": 80,
                "w": 440,
                "h": 240
              },
              "props": {
                "countInBeats": 4
              }
            },
            {
              "id": "feedback",
              "type": "label",
              "name": "反馈",
              "layout": {
                "x": 24,
                "y": 340,
                "w": 752,
                "h": 40
              },
              "props": {
                "text": ""
              }
            }
          ]
        },
        "behavior": {
          "logicVersion": 3,
          "kind": "behavior",
          "nodes": [
            {
              "id": "b_onStart",
              "kind": "on",
              "event": "start"
            },
            {
              "id": "b_initTaps",
              "kind": "assign",
              "target": "local.taps",
              "value": {
                "expr": "[]"
              }
            },
            {
              "id": "b_startRhythm",
              "kind": "call",
              "target": "rhythm1",
              "method": "start",
              "arg": "{ bpm: q.bpm, beats: q.beats, countInBeats: 4 }"
            },
            {
              "id": "b_feedbackReady",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '听 4 拍预备，跟着圆盘打拍。', tone: 'info' }"
            },
            {
              "id": "b_start_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_start_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onTap",
              "kind": "on",
              "event": "rhythm1.tap"
            },
            {
              "id": "b_tap_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_tap_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.state.pendingScore }"
            },
            {
              "id": "b_pushTap",
              "kind": "assign",
              "target": "local.taps",
              "value": {
                "expr": "append(local.taps, event.payload.t)"
              }
            },
            {
              "id": "b_onRound",
              "kind": "on",
              "event": "rhythm1.roundDone"
            },
            {
              "id": "b_ratio",
              "kind": "assign",
              "target": "local.ratio",
              "value": {
                "expr": "rhythmScore(local.taps, q.grid, q.tolerance)"
              }
            },
            {
              "id": "b_countRound",
              "kind": "assign",
              "target": "t.rounds",
              "value": {
                "expr": "t.rounds + 1"
              }
            },
            {
              "id": "b_passed",
              "kind": "branch",
              "cond": "local.ratio >= q.passRatio"
            },
            {
              "id": "b_markAnswered",
              "kind": "assign",
              "target": "q.state.answered",
              "value": {
                "expr": "true"
              }
            },
            {
              "id": "b_addPending",
              "kind": "assign",
              "target": "q.state.pendingScore",
              "value": {
                "expr": "q.state.pendingScore + round(local.ratio * q.scoring)"
              }
            },
            {
              "id": "b_feedbackOk",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '节奏跟上了！', tone: 'success' }"
            },
            {
              "id": "b_retOk",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.state.pendingScore }"
            },
            {
              "id": "b_clearTaps",
              "kind": "assign",
              "target": "local.taps",
              "value": {
                "expr": "[]"
              }
            },
            {
              "id": "b_feedbackBad",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '没跟上，再来一轮。', tone: 'error' }"
            },
            {
              "id": "b_restartRhythm",
              "kind": "call",
              "target": "rhythm1",
              "method": "start",
              "arg": "{ bpm: q.bpm, beats: q.beats, countInBeats: 4 }"
            },
            {
              "id": "b_comment",
              "kind": "comment",
              "text": "多轮判定预设：一轮判定 → 达标计分返回 / 未达标清空重开（上限靠 finish 阈值控制）"
            }
          ],
          "edges": [
            {
              "id": "e_b_onStart_b_initTaps",
              "from": "b_onStart",
              "to": "b_initTaps"
            },
            {
              "id": "e_b_initTaps_b_startRhythm",
              "from": "b_initTaps",
              "to": "b_startRhythm"
            },
            {
              "id": "e_b_startRhythm_b_feedbackReady",
              "from": "b_startRhythm",
              "to": "b_feedbackReady"
            },
            {
              "id": "e_b_feedbackReady_b_start_guard",
              "from": "b_feedbackReady",
              "to": "b_start_guard"
            },
            {
              "id": "e_b_start_guard_b_start_guard_ret_true",
              "from": "b_start_guard",
              "to": "b_start_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onTap_b_tap_guard",
              "from": "b_onTap",
              "to": "b_tap_guard"
            },
            {
              "id": "e_b_tap_guard_b_pushTap_false",
              "from": "b_tap_guard",
              "to": "b_pushTap",
              "port": "false"
            },
            {
              "id": "e_b_tap_guard_b_tap_guard_ret_true",
              "from": "b_tap_guard",
              "to": "b_tap_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onRound_b_ratio",
              "from": "b_onRound",
              "to": "b_ratio"
            },
            {
              "id": "e_b_ratio_b_countRound",
              "from": "b_ratio",
              "to": "b_countRound"
            },
            {
              "id": "e_b_countRound_b_passed",
              "from": "b_countRound",
              "to": "b_passed"
            },
            {
              "id": "e_b_passed_b_markAnswered_true",
              "from": "b_passed",
              "to": "b_markAnswered",
              "port": "true"
            },
            {
              "id": "e_b_markAnswered_b_addPending",
              "from": "b_markAnswered",
              "to": "b_addPending"
            },
            {
              "id": "e_b_addPending_b_feedbackOk",
              "from": "b_addPending",
              "to": "b_feedbackOk"
            },
            {
              "id": "e_b_feedbackOk_b_retOk",
              "from": "b_feedbackOk",
              "to": "b_retOk"
            },
            {
              "id": "e_b_passed_b_clearTaps_false",
              "from": "b_passed",
              "to": "b_clearTaps",
              "port": "false"
            },
            {
              "id": "e_b_clearTaps_b_feedbackBad",
              "from": "b_clearTaps",
              "to": "b_feedbackBad"
            },
            {
              "id": "e_b_feedbackBad_b_restartRhythm",
              "from": "b_feedbackBad",
              "to": "b_restartRhythm"
            }
          ],
          "locals": [
            {
              "key": "taps",
              "type": "json",
              "init": []
            },
            {
              "key": "ratio",
              "type": "number",
              "init": 0
            }
          ]
        },
        "description": "跟着节拍在圆盘打拍：演示 rhythm.tap/roundDone 事件、rhythmScore 判定与多轮重试。",
        "state": [
          {
            "key": "answered",
            "type": "boolean",
            "init": false
          },
          {
            "key": "pendingScore",
            "type": "number",
            "init": 0
          }
        ],
        "typeState": [
          {
            "key": "rounds",
            "type": "number",
            "init": 0
          }
        ]
      }
    ],
    "tables": {
      "rhythm-tap": {
        "columns": [
          {
            "key": "prompt",
            "label": "题面",
            "type": "text"
          },
          {
            "key": "grid",
            "label": "节奏栅格（秒）",
            "type": "json"
          },
          {
            "key": "bpm",
            "label": "速度",
            "type": "number"
          },
          {
            "key": "beats",
            "label": "拍数",
            "type": "number"
          },
          {
            "key": "tolerance",
            "label": "容差（秒）",
            "type": "number"
          },
          {
            "key": "passRatio",
            "label": "达标比例",
            "type": "number"
          },
          {
            "key": "scoring",
            "label": "分值",
            "type": "number"
          }
        ],
        "rows": [
          {
