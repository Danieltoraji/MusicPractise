            "passRatio": 0.8,
            "scoring": 10
          },
          {
            "id": "row_104bpm",
            "prompt": "提高到 104 BPM",
            "grid": [
              0,
              0.288,
              0.577,
              0.865,
              1.154,
              1.442,
              1.731,
              2.019,
              2.308,
              2.596,
              2.885,
