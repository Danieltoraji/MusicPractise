              3.75,
              4.038,
              4.327
            ],
            "bpm": 104,
            "beats": 8,
            "tolerance": 0.12,
            "passRatio": 0.8,
            "scoring": 10
          }
        ]
      }
    },
    "run": {
      "order": "manifest",
      "count": null,
      "seed": null,
      "shuffleWithinPhase": true
    },
    "flow": {
      "logicVersion": 3,
      "kind": "flow",
      "nodes": [
        {
          "id": "f_start",
          "kind": "start"
        },
        {
          "id": "f_each",
          "kind": "foreach",
          "items": "run.questions",
          "itemVar": "slot",
          "indexVar": "index"
        },
        {
          "id": "f_ask",
          "kind": "ask",
          "target": "local.slot",
          "resultVar": "result"
        },
        {
          "id": "f_addScore",
          "kind": "assign",
          "target": "v.score",
          "value": {
            "expr": "v.score + (local.result.scoreDelta || 0)"
          }
        },
        {
          "id": "f_setRow",
          "kind": "assign",
          "target": "v.row",
          "value": {
            "expr": "local.index + 1"
          }
        },
        {
          "id": "f_settled",
          "kind": "setView",
          "view": "settled"
        },
        {
          "id": "f_finish",
          "kind": "finish",
          "passed": "v.score >= 15"
        },
        {
          "id": "f_comment",
          "kind": "comment",
          "text": "预设：顺序遍历题单 → 每题一次 ask → 应用 scoreDelta → 切结算视图 → 结算（数据增删不需要改本图）"
        }
      ],
      "edges": [
        {
          "id": "e_f_start_f_each",
          "from": "f_start",
          "to": "f_each"
        },
        {
          "id": "e_f_each_f_ask_true",
          "from": "f_each",
          "to": "f_ask",
          "port": "true"
        },
        {
          "id": "e_f_ask_f_addScore",
          "from": "f_ask",
          "to": "f_addScore"
        },
        {
          "id": "e_f_addScore_f_setRow",
          "from": "f_addScore",
          "to": "f_setRow"
        },
        {
          "id": "e_f_setRow_f_each",
          "from": "f_setRow",
          "to": "f_each"
        },
        {
          "id": "e_f_each_f_settled_false",
          "from": "f_each",
          "to": "f_settled",
          "port": "false"
        },
        {
          "id": "e_f_settled_f_finish",
          "from": "f_settled",
          "to": "f_finish"
        }
      ],
      "vars": [
        {
          "key": "score",
          "type": "number",
          "init": 0
        },
        {
          "key": "row",
          "type": "number",
          "init": 0
        }
      ]
    }
  }
}
