            "y": 12,
            "w": 536,
            "h": 40
          },
          "props": {
            "text": "🎹 音色实验室"
          }
        },
        {
          "id": "progressLabel",
          "type": "label",
          "name": "进度",
          "view": "lab",
          "layout": {
            "x": 600,
            "y": 16,
            "w": 176,
            "h": 28
          },
          "bindings": {
            "text": "'进度 ' + v.row + ' / ' + run.total"
          }
        },
        {
          "id": "settledLabel",
          "type": "label",
          "name": "结算文本",
          "view": "settled",
          "layout": {
            "x": 200,
            "y": 120,
            "w": 400,
            "h": 48
          },
          "bindings": {
            "text": "'已听 ' + run.total + ' 种音色'"
          }
        }
      ]
