    "types": [
      {
        "id": "synth-demo",
        "name": "合成器演示",
        "surface": {
          "components": [
            {
              "id": "waveLabel",
              "type": "label",
              "name": "音色",
              "layout": {
                "x": 24,
                "y": 16,
                "w": 260,
                "h": 32
              },
              "bindings": {
                "text": "q.wave"
              }
            },
            {
              "id": "titleLabel",
              "type": "label",
              "name": "音色名",
              "layout": {
