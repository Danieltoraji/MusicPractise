                "y": 16,
                "w": 476,
                "h": 32
              },
              "bindings": {
                "text": "q.title"
              }
            },
            {
              "id": "descLabel",
              "type": "label",
              "name": "说明",
              "layout": {
                "x": 24,
                "y": 60,
                "w": 752,
                "h": 56
              },
              "bindings": {
                "text": "q.desc"
              }
            },
            {
              "id": "playBtn",
              "type": "button",
              "name": "播放",
              "layout": {
                "x": 24,
                "y": 140,
                "w": 240,
                "h": 48
              },
              "props": {
                "text": "▶ 播放示例"
              }
            },
            {
              "id": "nextBtn",
              "type": "button",
              "name": "下一音色",
              "layout": {
                "x": 536,
                "y": 140,
                "w": 240,
                "h": 48
              },
              "props": {
                "text": "下一音色 ▶"
              }
            },
            {
              "id": "synth1",
              "type": "synth",
              "name": "合成器",
              "layout": {
                "x": 24,
                "y": 210,
                "w": 360,
                "h": 96
              },
              "props": {
                "wave": "sawtooth",
                "gain": 0.35
              }
            }
          ]
        },
        "behavior": {
          "logicVersion": 3,
          "kind": "behavior",
          "nodes": [
            {
              "id": "b_onStart",
              "kind": "on",
              "event": "start"
            },
            {
              "id": "b_setWave",
              "kind": "call",
              "target": "synth1",
              "method": "setWave",
              "arg": "{ wave: q.wave }"
            },
            {
              "id": "b_countHeard",
              "kind": "assign",
              "target": "t.heard",
              "value": {
                "expr": "t.heard + 1"
              }
            },
            {
              "id": "b_start_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_start_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onPlay",
              "kind": "on",
              "event": "playBtn.clicked"
            },
            {
              "id": "b_playNotes",
              "kind": "call",
              "target": "synth1",
              "method": "play",
              "arg": "{ notes: q.notes, wave: q.wave }"
            },
            {
              "id": "b_countPlay",
              "kind": "assign",
              "target": "q.state.played",
              "value": {
                "expr": "q.state.played + 1"
              }
            },
            {
              "id": "b_play_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_play_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onNext",
              "kind": "on",
              "event": "nextBtn.clicked"
            },
            {
              "id": "b_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_comment",
              "kind": "comment",
              "text": "音色实验室：播放命令带 wave/notes；下一音色手动收题"
            }
          ],
          "edges": [
            {
              "id": "e_b_onStart_b_setWave",
              "from": "b_onStart",
              "to": "b_setWave"
            },
            {
              "id": "e_b_setWave_b_countHeard",
              "from": "b_setWave",
              "to": "b_countHeard"
            },
            {
              "id": "e_b_countHeard_b_start_guard",
              "from": "b_countHeard",
              "to": "b_start_guard"
            },
            {
              "id": "e_b_start_guard_b_start_guard_ret_true",
              "from": "b_start_guard",
              "to": "b_start_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onPlay_b_playNotes",
              "from": "b_onPlay",
              "to": "b_playNotes"
            },
            {
              "id": "e_b_playNotes_b_countPlay",
              "from": "b_playNotes",
              "to": "b_countPlay"
            },
            {
              "id": "e_b_countPlay_b_play_guard",
              "from": "b_countPlay",
              "to": "b_play_guard"
            },
            {
              "id": "e_b_play_guard_b_play_guard_ret_true",
              "from": "b_play_guard",
              "to": "b_play_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onNext_b_ret",
              "from": "b_onNext",
              "to": "b_ret"
            }
          ]
        },
        "description": "一行数据 = 一种音色：点击播放试听，下一音色继续；演示 synth 组件的命令参数。",
        "state": [
          {
            "key": "answered",
            "type": "boolean",
            "init": false
          },
          {
            "key": "played",
            "type": "number",
            "init": 0
          }
        ],
        "typeState": [
          {
            "key": "heard",
            "type": "number",
            "init": 0
          }
        ]
      }
    ],
