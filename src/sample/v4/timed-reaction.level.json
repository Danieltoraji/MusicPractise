  "meta": {
    "title": "限时反应 · 3 秒作答",
    "description": "每题只有 3 秒！演示隐形 timer 组件的 start/stop/tick 与限时判定（v4：timer.tick → status:timeout）。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "练耳",
      "限时",
      "反应"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 3
  },
  "content": {
    "shell": {
      "views": [
        {
          "id": "main",
          "name": "主视图"
        },
        {
          "id": "settled",
          "name": "结算视图"
        }
      ],
      "components": [
        {
          "id": "titleLabel",
          "type": "label",
          "name": "关卡标题",
          "view": "main",
          "layout": {
            "x": 24,
            "y": 12,
            "w": 536,
            "h": 28
          },
          "props": {
            "text": "限时反应 · 3 秒作答"
          }
        },
        {
          "id": "scoreLabel",
          "type": "label",
          "name": "得分",
          "view": "main",
          "layout": {
