          }
        },
        {
          "id": "progressLabel",
          "type": "label",
          "name": "进度",
          "view": "main",
          "layout": {
            "x": 24,
            "y": 42,
            "w": 536,
            "h": 24
          },
          "bindings": {
            "text": "'进度 ' + v.row + ' / ' + run.total"
          }
        },
        {
          "id": "settledLabel",
          "type": "label",
          "name": "结算文本",
          "view": "settled",
          "layout": {
            "x": 200,
            "y": 110,
            "w": 400,
            "h": 48
          },
          "bindings": {
            "text": "'本关得分 ' + v.score"
          }
        }
      ]
    },
    "types": [
      {
        "id": "choice-timed",
        "name": "限时选择",
        "surface": {
          "components": [
            {
              "id": "prompt",
              "type": "label",
              "name": "题面",
              "layout": {
                "x": 24,
                "y": 16,
                "w": 552,
                "h": 32
              },
              "bindings": {
                "text": "q.prompt"
              }
            },
            {
              "id": "listenBtn",
              "type": "button",
              "name": "重听",
              "layout": {
                "x": 600,
                "y": 16,
                "w": 176,
                "h": 36
              },
              "props": {
                "text": "🔊 重听"
              }
            },
            {
              "id": "timerLabel",
              "type": "label",
              "name": "限时提示",
              "layout": {
                "x": 24,
                "y": 56,
                "w": 240,
                "h": 24
              },
              "props": {
                "text": "⏱ 限时作答"
              }
            },
            {
              "id": "choice1",
              "type": "choice",
              "name": "选项",
              "layout": {
                "x": 24,
                "y": 88,
                "w": 752,
                "h": 220
              }
            },
            {
              "id": "feedback",
              "type": "label",
              "name": "反馈",
              "layout": {
                "x": 24,
                "y": 320,
                "w": 752,
                "h": 40
              },
              "props": {
                "text": ""
              }
            },
            {
              "id": "timer1",
              "type": "timer",
              "name": "计时器",
              "visible": false
            },
            {
              "id": "sound1",
              "type": "sound",
              "name": "发声器"
            }
          ]
        },
        "behavior": {
          "logicVersion": 3,
          "kind": "behavior",
          "nodes": [
            {
              "id": "b_onStart",
              "kind": "on",
              "event": "start"
            },
            {
              "id": "b_setOptions",
              "kind": "call",
              "target": "choice1",
              "method": "setOptions",
              "arg": "{ options: q.options }"
            },
            {
              "id": "b_playListen",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_startTimer",
              "kind": "call",
              "target": "timer1",
              "method": "start",
              "arg": "{ ms: q.timeMs }"
            },
            {
              "id": "b_start_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_start_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onReplay",
              "kind": "on",
              "event": "listenBtn.clicked"
            },
            {
              "id": "b_playReplay",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_replay_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_replay_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onChosen",
              "kind": "on",
              "event": "choice1.chosen"
            },
            {
              "id": "b_chosen_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_chosen_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_isCorrect",
              "kind": "branch",
              "cond": "event.payload.index == q.answerIndex"
            },
            {
              "id": "b_markAnswered",
              "kind": "assign",
              "target": "q.state.answered",
              "value": {
                "expr": "true"
              }
            },
            {
              "id": "b_stopTimer",
              "kind": "call",
              "target": "timer1",
              "method": "stop"
            },
            {
              "id": "b_reveal",
              "kind": "call",
              "target": "choice1",
              "method": "reveal",
              "arg": "{ correctIndex: q.answerIndex }"
            },
            {
              "id": "b_feedbackOk",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '答对了！', tone: 'success' }"
            },
            {
              "id": "b_retOk",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring }"
            },
            {
              "id": "b_countWrong",
              "kind": "assign",
              "target": "q.state.attempts",
              "value": {
                "expr": "q.state.attempts + 1"
              }
            },
            {
              "id": "b_resetChoice",
              "kind": "call",
              "target": "choice1",
              "method": "reset"
            },
            {
              "id": "b_feedbackBad",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '不对，快再选！', tone: 'error' }"
            },
            {
              "id": "b_onTick",
              "kind": "on",
              "event": "timer1.tick"
            },
            {
              "id": "b_isAnswered",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_countTimeout",
              "kind": "assign",
              "target": "t.timeouts",
              "value": {
                "expr": "t.timeouts + 1"
              }
            },
            {
              "id": "b_feedbackTimeout",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '时间到！', tone: 'error' }"
            },
            {
              "id": "b_retTimeout",
              "kind": "return",
              "result": "{ status: 'timeout', correct: false, scoreDelta: 0 }"
            },
            {
              "id": "b_comment",
              "kind": "comment",
              "text": "限时返回预设：timer.tick → status:timeout；答对先 stop timer 再 return"
            }
          ],
          "edges": [
            {
              "id": "e_b_onStart_b_setOptions",
              "from": "b_onStart",
              "to": "b_setOptions"
            },
            {
              "id": "e_b_setOptions_b_playListen",
              "from": "b_setOptions",
              "to": "b_playListen"
            },
            {
              "id": "e_b_playListen_b_startTimer",
              "from": "b_playListen",
              "to": "b_startTimer"
            },
            {
              "id": "e_b_startTimer_b_start_guard",
              "from": "b_startTimer",
              "to": "b_start_guard"
            },
            {
              "id": "e_b_start_guard_b_start_guard_ret_true",
              "from": "b_start_guard",
              "to": "b_start_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onReplay_b_playReplay",
              "from": "b_onReplay",
              "to": "b_playReplay"
            },
            {
              "id": "e_b_playReplay_b_replay_guard",
              "from": "b_playReplay",
              "to": "b_replay_guard"
            },
            {
              "id": "e_b_replay_guard_b_replay_guard_ret_true",
              "from": "b_replay_guard",
              "to": "b_replay_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onChosen_b_chosen_guard",
              "from": "b_onChosen",
              "to": "b_chosen_guard"
            },
            {
              "id": "e_b_chosen_guard_b_isCorrect_false",
              "from": "b_chosen_guard",
              "to": "b_isCorrect",
              "port": "false"
            },
            {
              "id": "e_b_chosen_guard_b_chosen_guard_ret_true",
              "from": "b_chosen_guard",
              "to": "b_chosen_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_isCorrect_b_markAnswered_true",
              "from": "b_isCorrect",
              "to": "b_markAnswered",
              "port": "true"
            },
            {
              "id": "e_b_markAnswered_b_stopTimer",
              "from": "b_markAnswered",
              "to": "b_stopTimer"
            },
            {
              "id": "e_b_stopTimer_b_reveal",
              "from": "b_stopTimer",
              "to": "b_reveal"
            },
            {
              "id": "e_b_reveal_b_feedbackOk",
              "from": "b_reveal",
              "to": "b_feedbackOk"
            },
            {
              "id": "e_b_feedbackOk_b_retOk",
              "from": "b_feedbackOk",
              "to": "b_retOk"
            },
            {
              "id": "e_b_isCorrect_b_countWrong_false",
              "from": "b_isCorrect",
              "to": "b_countWrong",
              "port": "false"
            },
            {
              "id": "e_b_countWrong_b_resetChoice",
              "from": "b_countWrong",
              "to": "b_resetChoice"
            },
            {
              "id": "e_b_resetChoice_b_feedbackBad",
              "from": "b_resetChoice",
              "to": "b_feedbackBad"
            },
            {
              "id": "e_b_onTick_b_isAnswered",
              "from": "b_onTick",
              "to": "b_isAnswered"
            },
            {
              "id": "e_b_isAnswered_b_countTimeout_false",
              "from": "b_isAnswered",
              "to": "b_countTimeout",
              "port": "false"
            },
            {
              "id": "e_b_countTimeout_b_feedbackTimeout",
              "from": "b_countTimeout",
              "to": "b_feedbackTimeout"
            },
            {
              "id": "e_b_feedbackTimeout_b_retTimeout",
              "from": "b_feedbackTimeout",
              "to": "b_retTimeout"
            }
          ]
        },
        "description": "倒计时内选出正确答案：演示 timer 组件的 start/stop 与 tick 超时返回。",
        "state": [
