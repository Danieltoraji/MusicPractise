              "name": "重听",
              "layout": {
                "x": 600,
                "y": 16,
                "w": 176,
                "h": 36
              },
              "props": {
                "text": "🔊 重听"
              }
            },
            {
              "id": "feedback",
              "type": "label",
              "name": "反馈",
              "layout": {
                "x": 24,
                "y": 60,
                "w": 752,
                "h": 36
              },
              "props": {
                "text": ""
              }
            },
            {
              "id": "keys1",
              "type": "fingering",
              "name": "键盘",
              "layout": {
                "x": 24,
                "y": 110,
                "w": 752,
                "h": 190
              },
              "props": {
                "lowMidi": 60,
                "highMidi": 76
              }
            },
            {
              "id": "resetBtn",
              "type": "button",
              "name": "清空",
              "layout": {
                "x": 24,
                "y": 320,
                "w": 176,
                "h": 44
              },
              "props": {
                "text": "↺ 清空"
              }
            },
            {
              "id": "sound1",
              "type": "sound",
              "name": "发声器"
            }
          ]
        },
        "behavior": {
          "logicVersion": 3,
          "kind": "behavior",
          "nodes": [
            {
              "id": "b_onStart",
              "kind": "on",
              "event": "start"
            },
            {
              "id": "b_initNotes",
              "kind": "assign",
              "target": "local.notes",
              "value": {
                "expr": "[]"
              }
            },
            {
              "id": "b_playListen",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_start_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_start_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onReplay",
              "kind": "on",
              "event": "listenBtn.clicked"
            },
            {
              "id": "b_playReplay",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_replay_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_replay_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onReset",
              "kind": "on",
              "event": "resetBtn.clicked"
            },
            {
              "id": "b_clearNotes",
              "kind": "assign",
              "target": "local.notes",
              "value": {
                "expr": "[]"
              }
            },
            {
              "id": "b_clearKeys",
              "kind": "call",
              "target": "keys1",
              "method": "clear"
            },
            {
              "id": "b_feedbackReset",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '已清空，重新弹一遍。', tone: 'info' }"
            },
            {
              "id": "b_reset_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_reset_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onKey",
              "kind": "on",
              "event": "keys1.keyClicked"
            },
            {
              "id": "b_key_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_key_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring }"
            },
            {
              "id": "b_pushNote",
              "kind": "assign",
              "target": "local.notes",
              "value": {
                "expr": "append(local.notes, event.payload.midi)"
              }
            },
            {
              "id": "b_isDone",
              "kind": "branch",
              "cond": "join(local.notes, ',') == join(q.targetNotes, ',')"
            },
            {
              "id": "b_markAnswered",
              "kind": "assign",
              "target": "q.state.answered",
              "value": {
                "expr": "true"
              }
            },
            {
              "id": "b_reward",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.rewardChord }"
            },
            {
              "id": "b_feedbackOk",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '旋律完全正确！', tone: 'success' }"
            },
            {
              "id": "b_retOk",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring }"
            },
            {
              "id": "b_isFull",
              "kind": "branch",
              "cond": "len(local.notes) >= len(q.targetNotes)"
            },
            {
              "id": "b_resetNotes",
              "kind": "assign",
              "target": "local.notes",
              "value": {
                "expr": "[]"
              }
            },
            {
              "id": "b_countAttempts",
              "kind": "assign",
              "target": "t.attempts",
              "value": {
                "expr": "t.attempts + 1"
              }
            },
            {
              "id": "b_resetKeys",
              "kind": "call",
              "target": "keys1",
              "method": "clear"
            },
            {
              "id": "b_feedbackBad",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '旋律不对，重听一遍再弹。', tone: 'error' }"
            },
            {
              "id": "b_comment",
              "kind": "comment",
              "text": "逐音累积 + 弹满自动判定；答错清空重来（预设「答错可重试」）"
            }
          ],
          "edges": [
