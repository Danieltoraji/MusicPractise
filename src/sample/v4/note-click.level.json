            },
            {
              "id": "e_b_markAnswered_b_highlightOk",
              "from": "b_markAnswered",
              "to": "b_highlightOk"
            },
            {
              "id": "e_b_highlightOk_b_reward",
              "from": "b_highlightOk",
              "to": "b_reward"
            },
            {
              "id": "e_b_reward_b_feedbackOk",
              "from": "b_reward",
              "to": "b_feedbackOk"
            },
            {
              "id": "e_b_isCorrect_b_countWrong_false",
              "from": "b_isCorrect",
              "to": "b_countWrong",
              "port": "false"
            },
            {
              "id": "e_b_countWrong_b_highlightBad",
              "from": "b_countWrong",
              "to": "b_highlightBad"
            },
            {
              "id": "e_b_highlightBad_b_buzz",
              "from": "b_highlightBad",
              "to": "b_buzz"
            },
            {
              "id": "e_b_buzz_b_feedbackBad",
              "from": "b_buzz",
              "to": "b_feedbackBad"
            },
            {
              "id": "e_b_onNext_b_next_next",
              "from": "b_onNext",
              "to": "b_next_next"
            },
            {
              "id": "e_b_next_next_b_next_next_scored_true",
              "from": "b_next_next",
              "to": "b_next_next_scored",
              "port": "true"
            },
            {
              "id": "e_b_next_next_b_next_next_skipped_false",
              "from": "b_next_next",
              "to": "b_next_next_skipped",
              "port": "false"
            }
          ]
        },
