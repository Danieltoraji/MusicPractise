    "types": [
      {
        "id": "staff-click",
        "name": "五线谱听音",
        "surface": {
          "components": [
            {
              "id": "prompt",
              "type": "label",
              "name": "题面",
              "layout": {
                "x": 24,
                "y": 16,
                "w": 552,
                "h": 32
              },
              "bindings": {
                "text": "q.prompt"
              }
            },
            {
              "id": "listenBtn",
              "type": "button",
              "name": "重听",
              "layout": {
                "x": 600,
                "y": 16,
                "w": 176,
                "h": 36
              },
              "props": {
                "text": "🔊 听"
              }
            },
            {
              "id": "staff1",
              "type": "staff",
              "name": "五线谱",
              "layout": {
                "x": 24,
                "y": 72,
                "w": 752,
                "h": 264
              },
              "props": {
                "clickable": true
              }
            },
            {
              "id": "feedback",
              "type": "label",
              "name": "反馈",
              "layout": {
                "x": 24,
                "y": 344,
                "w": 752,
                "h": 40
              },
              "props": {
                "text": ""
              }
            },
            {
              "id": "nextBtn",
              "type": "button",
              "name": "下一题",
              "layout": {
                "x": 600,
                "y": 388,
                "w": 176,
                "h": 44
              },
              "props": {
                "text": "下一题 →"
              }
            },
            {
              "id": "sound1",
              "type": "sound",
              "name": "发声器"
            }
          ]
        },
        "behavior": {
          "logicVersion": 3,
          "kind": "behavior",
          "nodes": [
            {
              "id": "b_onStart",
              "kind": "on",
              "event": "start"
            },
            {
              "id": "b_setMusic",
              "kind": "call",
              "target": "staff1",
              "method": "setMusic",
              "arg": "{ music: q.music }"
            },
            {
              "id": "b_playListen",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_countHeard",
              "kind": "assign",
              "target": "t.heard",
              "value": {
                "expr": "t.heard + 1"
              }
            },
            {
              "id": "b_start_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_start_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onReplay",
              "kind": "on",
              "event": "listenBtn.clicked"
            },
            {
              "id": "b_playReplay",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_replay_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_replay_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onNote",
              "kind": "on",
              "event": "staff1.noteClicked"
            },
            {
              "id": "b_click_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_click_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_isCorrect",
              "kind": "branch",
              "cond": "event.payload.midi == q.answerMidi"
            },
            {
              "id": "b_markAnswered",
              "kind": "assign",
              "target": "q.state.answered",
              "value": {
                "expr": "true"
              }
            },
            {
              "id": "b_highlightOk",
              "kind": "call",
              "target": "staff1",
              "method": "highlight",
              "arg": "{ target: q.answerMidi, style: 'correct' }"
            },
            {
              "id": "b_reward",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.rewardChord }"
            },
            {
              "id": "b_feedbackOk",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '答对了！点「下一题」继续。', tone: 'success' }"
            },
            {
              "id": "b_countWrong",
              "kind": "assign",
              "target": "q.state.wrongAttempts",
              "value": {
                "expr": "q.state.wrongAttempts + 1"
              }
            },
            {
              "id": "b_highlightBad",
              "kind": "call",
              "target": "staff1",
              "method": "highlight",
              "arg": "{ target: event.payload.midi, style: 'wrong' }"
            },
            {
              "id": "b_buzz",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.wrongBuzz }"
            },
            {
              "id": "b_feedbackBad",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '不是这个音，再听听。', tone: 'error' }"
            },
            {
              "id": "b_onNext",
              "kind": "on",
              "event": "nextBtn.clicked"
            },
            {
              "id": "b_next_next",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_next_next_scored",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring }"
            },
            {
              "id": "b_next_next_skipped",
              "kind": "return",
              "result": "{ status: 'skipped', correct: false, scoreDelta: 0 }"
            },
            {
              "id": "b_comment",
              "kind": "comment",
              "text": "首次答对计分；答错高亮错误音并给反应；下一题收题（未答对=跳过）"
            }
          ],
          "edges": [
            {
              "id": "e_b_onStart_b_setMusic",
              "from": "b_onStart",
              "to": "b_setMusic"
            },
            {
              "id": "e_b_setMusic_b_playListen",
