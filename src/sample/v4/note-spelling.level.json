  "meta": {
    "title": "音名拼写 · 输入框作答",
    "description": "听和弦，用音名拼写它并回车提交。演示 input 组件与大小写无关的文本判定（含 aliases 兜底与提示）。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "乐理",
      "和弦",
      "拼写"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 2
  },
  "content": {
