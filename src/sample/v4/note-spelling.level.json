    "flow": {
      "logicVersion": 3,
      "kind": "flow",
      "nodes": [
        {
          "id": "f_start",
          "kind": "start"
        },
        {
          "id": "f_each",
          "kind": "foreach",
          "items": "run.questions",
          "itemVar": "slot",
          "indexVar": "index"
        },
        {
          "id": "f_ask",
          "kind": "ask",
          "target": "local.slot",
          "resultVar": "result"
        },
        {
          "id": "f_addScore",
          "kind": "assign",
          "target": "v.score",
          "value": {
            "expr": "v.score + (local.result.scoreDelta || 0)"
          }
        },
        {
          "id": "f_setRow",
          "kind": "assign",
          "target": "v.row",
          "value": {
            "expr": "local.index + 1"
          }
        },
        {
          "id": "f_settled",
          "kind": "setView",
          "view": "settled"
        },
        {
          "id": "f_finish",
          "kind": "finish",
          "passed": "v.score >= 20"
        },
        {
          "id": "f_comment",
          "kind": "comment",
          "text": "预设：顺序遍历题单 → 每题一次 ask → 应用 scoreDelta → 切结算视图 → 结算（数据增删不需要改本图）"
        }
      ],
