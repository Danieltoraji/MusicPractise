            "w": 176,
            "h": 28
          },
          "bindings": {
            "text": "'得分 ' + v.score"
          }
        },
        {
          "id": "progressLabel",
          "type": "label",
          "name": "进度",
          "view": "main",
          "layout": {
            "x": 24,
            "y": 42,
            "w": 536,
            "h": 24
          },
          "bindings": {
            "text": "'进度 ' + v.row + ' / ' + run.total"
          }
        },
        {
          "id": "settledLabel",
          "type": "label",
          "name": "结算文本",
          "view": "settled",
          "layout": {
            "x": 200,
            "y": 110,
            "w": 400,
            "h": 48
          },
          "bindings": {
            "text": "'本关得分 ' + v.score"
          }
        }
      ]
    },
    "types": [
      {
        "id": "text-answer",
        "name": "文本作答",
        "surface": {
          "components": [
            {
              "id": "prompt",
              "type": "label",
              "name": "题面",
              "layout": {
                "x": 24,
                "y": 16,
                "w": 552,
                "h": 32
              },
              "bindings": {
                "text": "q.prompt"
              }
            },
            {
              "id": "listenBtn",
              "type": "button",
              "name": "重听",
              "layout": {
                "x": 600,
                "y": 16,
                "w": 176,
                "h": 36
              },
              "props": {
                "text": "🔊 重听"
              }
            },
            {
              "id": "input1",
              "type": "input",
              "name": "作答输入框",
              "layout": {
                "x": 24,
                "y": 100,
                "w": 480,
                "h": 56
              },
              "props": {
                "placeholder": "输入音名，如 CEG，回车提交"
              }
            },
            {
              "id": "feedback",
              "type": "label",
              "name": "反馈",
              "layout": {
                "x": 24,
                "y": 180,
                "w": 752,
                "h": 40
              },
              "props": {
                "text": ""
              }
            },
            {
              "id": "sound1",
              "type": "sound",
              "name": "发声器"
            }
          ]
        },
        "behavior": {
          "logicVersion": 3,
          "kind": "behavior",
          "nodes": [
            {
              "id": "b_onStart",
              "kind": "on",
              "event": "start"
            },
            {
              "id": "b_playListen",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_start_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_start_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onReplay",
              "kind": "on",
              "event": "listenBtn.clicked"
            },
            {
              "id": "b_playReplay",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_replay_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_replay_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onSubmit",
              "kind": "on",
              "event": "input1.submitted"
            },
            {
              "id": "b_submit_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_submit_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_countTry",
              "kind": "assign",
              "target": "q.state.attempts",
              "value": {
                "expr": "q.state.attempts + 1"
              }
            },
            {
              "id": "b_isCorrect",
              "kind": "branch",
              "cond": "upper(event.payload.value) == upper(q.answer) || contains(q.aliases, lower(event.payload.value))"
            },
            {
              "id": "b_markAnswered",
              "kind": "assign",
              "target": "q.state.answered",
              "value": {
                "expr": "true"
              }
            },
            {
              "id": "b_feedbackOk",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '拼写正确！', tone: 'success' }"
            },
            {
              "id": "b_retOk",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring }"
            },
            {
              "id": "b_clearInput",
              "kind": "call",
              "target": "input1",
              "method": "clear"
            },
            {
              "id": "b_showHint",
              "kind": "branch",
              "cond": "q.state.attempts >= 2"
            },
            {
              "id": "b_feedbackHint",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '提示：' + q.hint, tone: 'info' }"
            },
            {
              "id": "b_feedbackBad",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '还不对，先听一遍再输入。', tone: 'error' }"
            },
            {
              "id": "b_comment",
              "kind": "comment",
              "text": "提交即判定：大小写无关 + aliases 兜底；两次错误后给提示（预设「提示/反馈」）"
            }
          ],
          "edges": [
            {
              "id": "e_b_onStart_b_playListen",
              "from": "b_onStart",
              "to": "b_playListen"
            },
            {
              "id": "e_b_playListen_b_start_guard",
              "from": "b_playListen",
              "to": "b_start_guard"
            },
            {
              "id": "e_b_start_guard_b_start_guard_ret_true",
              "from": "b_start_guard",
              "to": "b_start_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onReplay_b_playReplay",
              "from": "b_onReplay",
              "to": "b_playReplay"
            },
            {
              "id": "e_b_playReplay_b_replay_guard",
              "from": "b_playReplay",
              "to": "b_replay_guard"
            },
            {
              "id": "e_b_replay_guard_b_replay_guard_ret_true",
              "from": "b_replay_guard",
              "to": "b_replay_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onSubmit_b_submit_guard",
              "from": "b_onSubmit",
              "to": "b_submit_guard"
            },
            {
              "id": "e_b_submit_guard_b_countTry_false",
              "from": "b_submit_guard",
              "to": "b_countTry",
              "port": "false"
            },
            {
              "id": "e_b_submit_guard_b_submit_guard_ret_true",
              "from": "b_submit_guard",
              "to": "b_submit_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_countTry_b_isCorrect",
              "from": "b_countTry",
              "to": "b_isCorrect"
            },
            {
              "id": "e_b_isCorrect_b_markAnswered_true",
              "from": "b_isCorrect",
              "to": "b_markAnswered",
              "port": "true"
            },
            {
              "id": "e_b_markAnswered_b_feedbackOk",
              "from": "b_markAnswered",
              "to": "b_feedbackOk"
            },
            {
              "id": "e_b_feedbackOk_b_retOk",
              "from": "b_feedbackOk",
              "to": "b_retOk"
            },
            {
              "id": "e_b_isCorrect_b_clearInput_false",
              "from": "b_isCorrect",
              "to": "b_clearInput",
              "port": "false"
            },
            {
              "id": "e_b_clearInput_b_showHint",
              "from": "b_clearInput",
              "to": "b_showHint"
            },
            {
              "id": "e_b_showHint_b_feedbackHint_true",
              "from": "b_showHint",
              "to": "b_feedbackHint",
              "port": "true"
            },
            {
              "id": "e_b_showHint_b_feedbackBad_false",
              "from": "b_showHint",
              "to": "b_feedbackBad",
              "port": "false"
            }
          ]
        },
        "description": "输入音名（如 CEG）回车提交：演示 input.submitted、大小写无关比较与 aliases 兜底。",
        "state": [
          {
            "key": "answered",
            "type": "boolean",
            "init": false
          },
          {
