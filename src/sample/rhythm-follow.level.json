{
  "schemaVersion": 3,
  "kind": "level",
  "id": "res_01J9F0F0F0F0F0F0F0F0F0F0F0",
  "version": "1.0.0",
  "meta": {
    "title": "节奏跟拍",
    "description": "跟随节拍器在圆盘上打拍子，节奏判定全在规则里（rhythmScore 表达式函数）。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "节奏",
      "跟拍"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 2
  },
  "refs": [],
  "content": {
    "components": [
      {
        "id": "scoreLabel",
        "type": "label",
        "name": "得分",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 20,
          "w": 300,
          "h": 40
        },
        "props": {
          "text": "得分: 0"
        },
        "view": "main"
      },
      {
        "id": "rhythm1",
        "type": "rhythm",
        "name": "节奏训练",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 90,
          "w": 720,
          "h": 280
        },
        "props": {
          "countInBeats": 4
        },
        "view": "main"
      },
      {
        "id": "feedback",
        "type": "label",
        "name": "反馈",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 390,
          "w": 720,
          "h": 48
        },
        "props": {
          "text": ""
        },
        "view": "main"
      },
      {
        "id": "nextBtn",
        "type": "button",
        "name": "下一题",
        "visible": true,
        "layout": {
          "x": 620,
          "y": 460,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "下一题 →",
          "enabled": false
        },
        "view": "main"
      }
    ],
    "logic": {
      "logicVersion": 2,
      "variables": {
        "score": 0,
        "taps": [],
        "done": false
      },
      "nodes": [
        {
          "id": "load_on",
          "kind": "on",
          "event": "question.loaded"
        },
        {
          "id": "load_d0",
          "kind": "call",
          "target": "rhythm1",
          "method": "start",
          "args": [
            "{bpm: q.data.bpm, beats: 8, countInBeats: 4}"
          ]
        },
        {
          "id": "load_d1",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: false}"
          ]
        },
        {
          "id": "load_d2",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: '预备拍后，跟着节拍在圆盘上打拍子', tone: 'info'}"
          ]
        },
        {
          "id": "collect_on",
          "kind": "on",
          "event": "rhythm1.tap"
        },
        {
          "id": "collect_d0",
          "kind": "assign",
          "target": "taps",
          "value": {
            "expr": "append(v.taps, event.t)"
          }
        },
        {
          "id": "judge_on",
          "kind": "on",
          "event": "rhythm1.roundDone"
        },
        {
          "id": "judge_d0",
          "kind": "emit",
          "event": "rhythm:judge",
          "payload": {
            "score": "rhythmScore(v.taps, q.data.grid, 120)"
          }
        },
        {
          "id": "judge_d1",
          "kind": "assign",
          "target": "taps",
          "value": {
            "expr": "[]"
          }
        },
        {
          "id": "judged_on",
          "kind": "on",
          "event": "rhythm:judge"
        },
        {
          "id": "judged_cond",
          "kind": "branch",
          "cond": "(event.score >= 0.6)"
        },
        {
          "id": "judged_d0",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: '不错！节奏契合度 ' + round(event.score * 100) + '%', tone: 'success'}"
          ]
        },
        {
          "id": "judged_d1",
          "kind": "assign",
          "target": "score",
          "value": {
            "expr": "v.score + round(event.score * q.scoring.max)"
          }
        },
        {
          "id": "judged_d2",
          "kind": "call",
          "target": "scoreLabel",
          "method": "show",
          "args": [
            "{text: '得分: ' + v.score, tone: 'success'}"
          ]
        },
        {
          "id": "judged_d3",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: true}"
          ]
        },
        {
          "id": "judged_e0",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: '节奏还不够稳，再来一轮', tone: 'error'}"
          ]
        },
        {
          "id": "judged_e1",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: true}"
          ]
        },
        {
          "id": "judged_e2",
          "kind": "call",
          "target": "rhythm1",
          "method": "start",
          "args": [
            "{bpm: q.data.bpm, beats: 8, countInBeats: 4}"
          ]
        },
        {
          "id": "next-or-restart_on",
          "kind": "on",
          "event": "nextBtn.clicked"
        },
        {
          "id": "next-or-restart_cond",
          "kind": "branch",
          "cond": "(!v.done)"
        },
        {
          "id": "next-or-restart_d0",
          "kind": "call",
          "target": "question",
          "method": "next",
          "args": []
        },
        {
          "id": "next-or-restart_e0",
          "kind": "call",
          "target": "level",
          "method": "restart",
          "args": []
        },
        {
          "id": "on-finish_on",
          "kind": "on",
          "event": "level.finished"
        },
        {
          "id": "on-finish_d0",
          "kind": "assign",
          "target": "done",
          "value": {
            "expr": "true"
          }
        },
        {
          "id": "on-finish_d1",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: '节奏测试完成！得分 ' + v.score + ' 🎉', tone: 'info'}"
          ]
        },
        {
          "id": "on-finish_d2",
          "kind": "call",
          "target": "nextBtn",
          "method": "setText",
          "args": [
            "{text: '重新开始'}"
          ]
        },
        {
          "id": "on-finish_d3",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: true}"
          ]
        }
      ],
      "edges": [
        {
          "id": "m1",
          "from": "load_d0",
          "to": "load_d1"
        },
        {
          "id": "m2",
          "from": "load_d1",
          "to": "load_d2"
        },
        {
          "id": "m3",
          "from": "load_on",
          "to": "load_d0"
        },
        {
          "id": "m4",
          "from": "collect_on",
          "to": "collect_d0"
        },
        {
          "id": "m5",
          "from": "judge_d0",
          "to": "judge_d1"
        },
        {
          "id": "m6",
          "from": "judge_on",
          "to": "judge_d0"
        },
        {
          "id": "m7",
          "from": "judged_on",
          "to": "judged_cond"
        },
        {
          "id": "m8",
          "from": "judged_d0",
          "to": "judged_d1"
        },
        {
          "id": "m9",
          "from": "judged_d1",
          "to": "judged_d2"
        },
        {
          "id": "m10",
          "from": "judged_d2",
          "to": "judged_d3"
        },
        {
          "id": "m11",
          "from": "judged_cond",
          "to": "judged_d0",
          "port": "true"
        },
        {
          "id": "m12",
          "from": "judged_e0",
          "to": "judged_e1"
        },
        {
          "id": "m13",
          "from": "judged_e1",
          "to": "judged_e2"
        },
        {
          "id": "m14",
          "from": "judged_cond",
          "to": "judged_e0",
          "port": "false"
        },
        {
          "id": "m15",
          "from": "next-or-restart_on",
          "to": "next-or-restart_cond"
        },
        {
          "id": "m16",
          "from": "next-or-restart_cond",
          "to": "next-or-restart_d0",
          "port": "true"
        },
        {
          "id": "m17",
          "from": "next-or-restart_cond",
          "to": "next-or-restart_e0",
          "port": "false"
        },
        {
          "id": "m18",
          "from": "on-finish_d0",
          "to": "on-finish_d1"
        },
        {
          "id": "m19",
          "from": "on-finish_d1",
          "to": "on-finish_d2"
        },
        {
          "id": "m20",
          "from": "on-finish_d2",
          "to": "on-finish_d3"
        },
        {
          "id": "m21",
          "from": "on-finish_on",
          "to": "on-finish_d0"
        }
      ]
    },
    "flow": {
      "order": "sequential",
      "count": null,
      "pass": {
        "expr": "v.score >= 15"
      }
    },
    "views": [
      {
        "id": "main",
        "name": "主视图"
      }
    ],
    "table": {
      "columns": [
        {
          "key": "prompt",
          "label": "题面",
          "type": "json"
        },
        {
          "key": "data",
          "label": "数据",
          "type": "json"
        },
        {
          "key": "scoring",
          "label": "分值",
          "type": "json"
        }
      ],
      "rows": [
        {
          "prompt": {
            "text": "80 BPM · 8 拍，跟着打"
          },
          "data": {
            "grid": [
              0,
              0.75,
              1.5,
              2.25,
              3,
              3.75,
              4.5,
              5.25
            ],
            "bpm": 80
          },
          "scoring": {
            "max": 10
          }
        },
        {
          "prompt": {
            "text": "提高到 104 BPM"
          },
          "data": {
            "grid": [
              0,
              0.577,
              1.154,
              1.731,
              2.308,
              2.885,
              3.462,
              4.038
            ],
            "bpm": 104
          },
          "scoring": {
            "max": 10
          }
        }
      ]
    }
  }
}
