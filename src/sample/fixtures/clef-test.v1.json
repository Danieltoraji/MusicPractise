{
  "schemaVersion": 1,
  "kind": "level",
  "id": "res_01J9E0E0E0E0E0E0E0E0E0E0E0",
  "version": "1.0.0",
  "meta": {
    "title": "听音点击 · 测试",
    "description": "谱面测试关：高/中/低音谱号各一题，每题铺出该谱号下加三线到上加三线的全部半音（含升号），点击任意音符即可试听其音高。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "谱面测试",
      "全音域",
      "谱号"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 5
  },
  "refs": [],
  "content": {
    "components": [
      {
        "id": "scoreLabel",
        "type": "label",
        "name": "得分",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 20,
          "w": 300,
          "h": 40
        },
        "props": {
          "text": "得分: 0"
        }
      },
      {
        "id": "clefLabel",
        "type": "label",
        "name": "当前谱号",
        "visible": true,
        "layout": {
          "x": 620,
          "y": 20,
          "w": 140,
          "h": 40
        },
        "props": {
          "text": ""
        }
      },
      {
        "id": "staff1",
        "type": "staff",
        "name": "全音域谱面",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 90,
          "w": 1900,
          "h": 240
        },
        "props": {
          "clef": "treble",
          "clickable": true
        },
        "bindings": {
          "music": "$q.data.music"
        }
      },
      {
        "id": "feedback",
        "type": "label",
        "name": "反馈文本",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 350,
          "w": 720,
          "h": 48
        },
        "props": {
          "text": ""
        }
      },
      {
        "id": "listenBtn",
        "type": "button",
        "name": "重听",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 430,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "🔊 重听",
          "enabled": true
        }
      },
      {
        "id": "nextBtn",
        "type": "button",
        "name": "下一题",
        "visible": true,
        "layout": {
          "x": 620,
          "y": 430,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "下一题 →",
          "enabled": false
        }
      },
      {
        "id": "sound1",
        "type": "sound",
        "name": "发声器",
        "visible": false
      }
    ],
    "logic": {
      "variables": {
        "score": 0,
        "done": false
      },
      "rules": [
        {
          "id": "load-question",
          "on": "level.questionLoaded",
          "do": [
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.listenNotes"
              }
            },
            {
              "cmd": "staff1.clear"
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": false
              }
            },
            {
              "cmd": "clefLabel.show",
              "args": {
                "text": "$q.data.clefLabel"
              }
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "听 —— 点击谱面上对应的音符（谱面可横向滚动，点任意音符可试听）",
                "tone": "info"
              }
            }
          ]
        },
        {
          "id": "replay",
          "on": "listenBtn.clicked",
          "do": [
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.listenNotes"
              }
            }
          ]
        },
        {
          "id": "check-answer",
          "on": "staff1.noteClicked",
          "when": [
            "event.midi == q.data.answerMidi"
          ],
          "do": [
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.rewardChord"
              }
            },
            {
              "cmd": "staff1.highlight",
              "args": {
                "target": "$event.midi",
                "style": "correct"
              }
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "答对了！",
                "tone": "success"
              }
            },
            {
              "set": "score",
              "expr": "v.score + q.scoring.max"
            },
            {
              "cmd": "scoreLabel.show",
              "args": {
                "text": "$expr:'得分: ' + v.score",
                "tone": "success"
              }
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": true
              }
            }
          ],
          "else": [
            {
              "cmd": "feedback.show",
              "args": {
                "text": "不对哦 —— 刚才点的是你听到的音吗？再试试",
                "tone": "error"
              }
            }
          ]
        },
        {
          "id": "next-or-restart",
          "on": "nextBtn.clicked",
          "when": [
            "!v.done"
          ],
          "do": [
            {
              "cmd": "level.next"
            }
          ],
          "else": [
            {
              "cmd": "level.restart"
            }
          ]
        },
        {
          "id": "on-finish",
          "on": "level.finished",
          "do": [
            {
              "set": "done",
              "expr": "true"
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "$expr:event.passed ? '谱面测试完成！得分 ' + v.score + ' 🎉' : '谱面测试完成！得分 ' + v.score",
                "tone": "info"
              }
            },
            {
              "cmd": "nextBtn.setText",
              "args": {
                "text": "重新开始"
              }
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": true
              }
            }
          ]
        }
      ]
    },
