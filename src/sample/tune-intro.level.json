{
  "schemaVersion": 4,
  "kind": "level",
  "id": "res_01J9F1F1F1F1F1F1F1F1F1F1F1",
  "version": "1.0.0",
  "meta": {
    "title": "调音入门",
    "description": "对麦克风唱/奏标准音（A4 440Hz 等），音分稳定在容差内保持 1 秒即通过。需要麦克风权限。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "调音",
      "麦克风"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 2
  },
  "content": {
    "shell": {
      "views": [
        {
          "id": "main",
          "name": "主视图"
        },
        {
          "id": "settled",
          "name": "结算视图"
        }
      ],
      "components": [
        {
          "id": "titleLabel",
          "type": "label",
          "name": "关卡标题",
          "view": "main",
          "layout": {
            "x": 24,
            "y": 12,
            "w": 536,
            "h": 28
          },
          "props": {
            "text": "调音入门"
          }
        },
        {
          "id": "scoreLabel",
          "type": "label",
          "name": "得分",
          "view": "main",
          "layout": {
            "x": 600,
            "y": 12,
            "w": 176,
            "h": 28
          },
          "bindings": {
            "text": "'得分 ' + v.score"
          }
        },
        {
          "id": "progressLabel",
          "type": "label",
          "name": "进度",
          "view": "main",
          "layout": {
            "x": 24,
            "y": 42,
            "w": 536,
            "h": 24
          },
          "bindings": {
            "text": "'进度 ' + v.row + ' / ' + run.total"
          }
        },
        {
          "id": "settledLabel",
          "type": "label",
          "name": "结算文本",
          "view": "settled",
          "layout": {
            "x": 200,
            "y": 110,
            "w": 400,
            "h": 48
          },
          "bindings": {
            "text": "'本关得分 ' + v.score"
          }
        }
      ]
    },
    "types": [
      {
        "id": "tuner-target",
        "name": "校音达标",
        "surface": {
          "components": [
            {
              "id": "prompt",
              "type": "label",
              "name": "题面",
              "layout": {
                "x": 24,
                "y": 16,
                "w": 552,
                "h": 32
              },
              "bindings": {
                "text": "q.prompt"
              }
            },
            {
              "id": "targetLabel",
              "type": "label",
              "name": "目标音",
              "layout": {
                "x": 600,
                "y": 16,
                "w": 176,
                "h": 32
              },
              "bindings": {
                "text": "q.targetName"
              }
            },
            {
              "id": "tuner1",
              "type": "tuner",
              "name": "校音器",
              "layout": {
                "x": 24,
                "y": 64,
                "w": 752,
                "h": 250
              }
            },
            {
              "id": "feedback",
              "type": "label",
              "name": "反馈",
              "layout": {
                "x": 24,
                "y": 330,
                "w": 752,
                "h": 40
              },
              "props": {
                "text": ""
              }
            }
          ]
        },
        "behavior": {
          "logicVersion": 3,
          "kind": "behavior",
          "nodes": [
            {
              "id": "b_onStart",
              "kind": "on",
              "event": "start"
            },
            {
              "id": "b_startTuner",
              "kind": "call",
              "target": "tuner1",
              "method": "start"
            },
            {
              "id": "b_feedbackStart",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '对麦克风持续发目标音，保持稳定。', tone: 'info' }"
            },
            {
              "id": "b_start_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_start_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onPitch",
              "kind": "on",
              "event": "tuner1.pitch"
            },
            {
              "id": "b_countPitch",
              "kind": "assign",
              "target": "t.pitchEvents",
              "value": {
                "expr": "t.pitchEvents + 1"
              }
            },
            {
              "id": "b_pitch_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_pitch_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_inTune",
              "kind": "assign",
              "target": "q.state.inTune",
              "value": {
                "expr": "abs(cents(event.payload.freq, q.targetMidi)) <= q.tolerance"
              }
            },
            {
              "id": "b_inside",
              "kind": "branch",
              "cond": "q.state.inTune"
            },
            {
              "id": "b_addStable",
              "kind": "assign",
              "target": "q.state.stableCount",
              "value": {
                "expr": "q.state.stableCount + 1"
              }
            },
            {
              "id": "b_stableEnough",
              "kind": "branch",
              "cond": "q.state.stableCount >= round(q.stableSeconds * 10)"
            },
            {
              "id": "b_markAnswered",
              "kind": "assign",
              "target": "q.state.answered",
              "value": {
                "expr": "true"
              }
            },
            {
              "id": "b_stopTuner",
              "kind": "call",
              "target": "tuner1",
              "method": "stop"
            },
            {
              "id": "b_feedbackOk",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '音准稳定达标！', tone: 'success' }"
            },
            {
              "id": "b_retOk",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring }"
            },
            {
              "id": "b_resetStable",
              "kind": "assign",
              "target": "q.state.stableCount",
              "value": {
                "expr": "0"
              }
            },
            {
              "id": "b_feedbackBad",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '再靠近一点目标音高。', tone: 'error' }"
            },
            {
              "id": "b_comment",
              "kind": "comment",
              "text": "稳定判定：连续 N 个 in-tune pitch 事件达标（stableSeconds × 10Hz 近似）"
            }
          ],
          "edges": [
            {
              "id": "e_b_onStart_b_startTuner",
              "from": "b_onStart",
              "to": "b_startTuner"
            },
            {
              "id": "e_b_startTuner_b_feedbackStart",
              "from": "b_startTuner",
              "to": "b_feedbackStart"
            },
            {
              "id": "e_b_feedbackStart_b_start_guard",
              "from": "b_feedbackStart",
              "to": "b_start_guard"
            },
            {
              "id": "e_b_start_guard_b_start_guard_ret_true",
              "from": "b_start_guard",
              "to": "b_start_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_onPitch_b_countPitch",
              "from": "b_onPitch",
              "to": "b_countPitch"
            },
            {
              "id": "e_b_countPitch_b_pitch_guard",
              "from": "b_countPitch",
              "to": "b_pitch_guard"
            },
            {
              "id": "e_b_pitch_guard_b_inTune_false",
              "from": "b_pitch_guard",
              "to": "b_inTune",
              "port": "false"
            },
            {
              "id": "e_b_pitch_guard_b_pitch_guard_ret_true",
              "from": "b_pitch_guard",
              "to": "b_pitch_guard_ret",
              "port": "true"
            },
            {
              "id": "e_b_inTune_b_inside",
              "from": "b_inTune",
              "to": "b_inside"
            },
            {
              "id": "e_b_inside_b_addStable_true",
              "from": "b_inside",
              "to": "b_addStable",
              "port": "true"
            },
            {
              "id": "e_b_addStable_b_stableEnough",
              "from": "b_addStable",
              "to": "b_stableEnough"
            },
            {
              "id": "e_b_stableEnough_b_markAnswered_true",
              "from": "b_stableEnough",
              "to": "b_markAnswered",
              "port": "true"
            },
            {
              "id": "e_b_markAnswered_b_stopTuner",
              "from": "b_markAnswered",
              "to": "b_stopTuner"
            },
            {
              "id": "e_b_stopTuner_b_feedbackOk",
              "from": "b_stopTuner",
              "to": "b_feedbackOk"
            },
            {
              "id": "e_b_feedbackOk_b_retOk",
              "from": "b_feedbackOk",
              "to": "b_retOk"
            },
            {
              "id": "e_b_inside_b_resetStable_false",
              "from": "b_inside",
              "to": "b_resetStable",
              "port": "false"
            },
            {
              "id": "e_b_resetStable_b_feedbackBad",
              "from": "b_resetStable",
              "to": "b_feedbackBad"
            }
          ]
        },
        "description": "对麦克风把音高稳定在目标音附近：演示 tuner.pitch 事件、cents 计算与连续命中判定。",
        "state": [
          {
            "key": "answered",
            "type": "boolean",
            "init": false
          },
          {
            "key": "inTune",
            "type": "boolean",
            "init": false
          },
          {
            "key": "stableCount",
            "type": "number",
            "init": 0
          }
        ],
        "typeState": [
          {
            "key": "pitchEvents",
            "type": "number",
            "init": 0
          }
        ]
      }
    ],
    "tables": {
      "tuner-target": {
        "columns": [
          {
            "key": "prompt",
            "label": "题面",
            "type": "text"
          },
          {
            "key": "targetMidi",
            "label": "目标音高",
            "type": "number"
          },
          {
            "key": "targetName",
            "label": "目标音名",
            "type": "text"
          },
          {
            "key": "tolerance",
            "label": "容差（音分）",
            "type": "number"
          },
          {
            "key": "stableSeconds",
            "label": "稳定秒数",
            "type": "number"
          },
          {
            "key": "scoring",
            "label": "分值",
            "type": "number"
          }
        ],
        "rows": [
          {
            "id": "row_a4",
            "prompt": "把声音稳定在 A4（440Hz）附近",
            "targetMidi": 69,
            "targetName": "A4 · 440Hz",
            "tolerance": 50,
            "stableSeconds": 1,
            "scoring": 10
          },
          {
            "id": "row_a3",
            "prompt": "再来一次：这次用更低的 A3",
            "targetMidi": 57,
            "targetName": "A3 · 220Hz",
            "tolerance": 50,
            "stableSeconds": 1,
            "scoring": 10
          }
        ]
      }
    },
    "run": {
      "order": "manifest",
      "count": null,
      "seed": null,
      "shuffleWithinPhase": true
    },
    "flow": {
      "logicVersion": 3,
      "kind": "flow",
      "nodes": [
        {
          "id": "f_start",
          "kind": "start"
        },
        {
          "id": "f_each",
          "kind": "foreach",
          "items": "run.questions",
          "itemVar": "slot",
          "indexVar": "index"
        },
        {
          "id": "f_ask",
          "kind": "ask",
          "target": "local.slot",
          "resultVar": "result"
        },
        {
          "id": "f_addScore",
          "kind": "assign",
          "target": "v.score",
          "value": {
            "expr": "v.score + (local.result.scoreDelta || 0)"
          }
        },
        {
          "id": "f_setRow",
          "kind": "assign",
          "target": "v.row",
          "value": {
            "expr": "local.index + 1"
          }
        },
        {
          "id": "f_settled",
          "kind": "setView",
          "view": "settled"
        },
        {
          "id": "f_finish",
          "kind": "finish",
          "passed": "v.score >= 20"
        },
        {
          "id": "f_comment",
          "kind": "comment",
          "text": "预设：顺序遍历题单 → 每题一次 ask → 应用 scoreDelta → 切结算视图 → 结算（数据增删不需要改本图）"
        }
      ],
      "edges": [
        {
          "id": "e_f_start_f_each",
          "from": "f_start",
          "to": "f_each"
        },
        {
          "id": "e_f_each_f_ask_true",
          "from": "f_each",
          "to": "f_ask",
          "port": "true"
        },
        {
          "id": "e_f_ask_f_addScore",
          "from": "f_ask",
          "to": "f_addScore"
        },
        {
          "id": "e_f_addScore_f_setRow",
          "from": "f_addScore",
          "to": "f_setRow"
        },
        {
          "id": "e_f_setRow_f_each",
          "from": "f_setRow",
          "to": "f_each"
        },
        {
          "id": "e_f_each_f_settled_false",
          "from": "f_each",
          "to": "f_settled",
          "port": "false"
        },
        {
          "id": "e_f_settled_f_finish",
          "from": "f_settled",
          "to": "f_finish"
        }
      ],
      "vars": [
        {
          "key": "score",
          "type": "number",
          "init": 0
        },
        {
          "key": "row",
          "type": "number",
          "init": 0
        }
      ]
    }
  }
}
