  "meta": {
    "title": "调音入门",
    "description": "对麦克风唱/奏标准音 A4（440Hz），音分稳定在 ±50 以内保持 1 秒即通过。需要麦克风权限。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "调音",
      "麦克风"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 2
  },
  "refs": [],
  "content": {
    "components": [
      {
        "id": "scoreLabel",
        "type": "label",
        "name": "得分",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 20,
          "w": 300,
          "h": 40
        },
        "props": {
          "text": "得分: 0"
        },
        "view": "main"
      },
      {
        "id": "tuner1",
        "type": "tuner",
        "name": "校音器",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 90,
          "w": 720,
          "h": 260
        },
        "view": "main"
      },
      {
        "id": "feedback",
        "type": "label",
        "name": "反馈",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 380,
          "w": 720,
          "h": 48
        },
        "props": {
          "text": ""
        },
        "view": "main"
      },
      {
        "id": "nextBtn",
        "type": "button",
        "name": "下一题",
        "visible": true,
        "layout": {
          "x": 620,
          "y": 460,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "下一题 →",
          "enabled": false
        },
        "view": "main"
      }
    ],
    "logic": {
      "logicVersion": 2,
      "variables": {
        "score": 0,
        "stable": 0,
        "scored": 0,
        "done": false,
        "__row": null
      },
      "nodes": [
        {
          "id": "q0_load",
          "kind": "on",
          "event": "level.questionLoaded"
        },
        {
          "id": "q0_gate",
          "kind": "branch",
          "cond": "v.__row == 0"
        },
        {
          "id": "q0_var_stable",
          "kind": "assign",
          "target": "stable",
          "value": {
            "expr": "0"
          }
        },
        {
          "id": "q0_var_scored",
          "kind": "assign",
          "target": "scored",
          "value": {
            "expr": "0"
          }
        },
        {
          "id": "q1_load",
          "kind": "on",
          "event": "level.questionLoaded"
        },
        {
          "id": "q1_gate",
          "kind": "branch",
          "cond": "v.__row == 1"
        },
        {
          "id": "q1_var_stable",
          "kind": "assign",
          "target": "stable",
          "value": {
            "expr": "0"
          }
        },
        {
          "id": "q1_var_scored",
          "kind": "assign",
          "target": "scored",
          "value": {
            "expr": "0"
          }
        },
        {
          "id": "load_on",
          "kind": "on",
          "event": "level.questionLoaded"
        },
        {
          "id": "load_d0",
          "kind": "call",
          "target": "tuner1",
          "method": "start",
          "args": []
        },
        {
          "id": "load_d1",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: false}"
          ]
        },
        {
          "id": "load_d2",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: '对麦克风唱「啊」或拉长音，音分稳定在 ±50 内保持 1 秒', tone: 'info'}"
          ]
        },
        {
          "id": "in-tune_on",
          "kind": "on",
          "event": "tuner1.pitch"
        },
        {
          "id": "in-tune_cond",
          "kind": "branch",
          "cond": "(v.scored == 0) && (abs(event.cents) < 50)"
        },
        {
          "id": "in-tune_d0",
          "kind": "assign",
          "target": "stable",
          "value": {
            "expr": "v.stable + 1"
          }
        },
        {
          "id": "in-tune_e0",
          "kind": "assign",
          "target": "stable",
          "value": {
            "expr": "0"
          }
        },
        {
          "id": "passed_on",
          "kind": "on",
          "event": "tuner1.pitch"
        },
        {
          "id": "passed_cond",
          "kind": "branch",
          "cond": "(v.stable >= 10) && (v.scored == 0)"
        },
        {
          "id": "passed_d0",
          "kind": "assign",
          "target": "scored",
          "value": {
            "expr": "1"
          }
        },
        {
          "id": "passed_d1",
          "kind": "assign",
          "target": "score",
          "value": {
            "expr": "v.score + q.scoring.max"
          }
        },
        {
          "id": "passed_d2",
          "kind": "call",
          "target": "scoreLabel",
          "method": "show",
          "args": [
            "{text: '得分: ' + v.score, tone: 'success'}"
          ]
        },
        {
          "id": "passed_d3",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: '音准了！保持得很好', tone: 'success'}"
          ]
        },
        {
          "id": "passed_d4",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: true}"
          ]
        },
        {
          "id": "next-or-restart_on",
          "kind": "on",
          "event": "nextBtn.clicked"
        },
        {
          "id": "next-or-restart_cond",
          "kind": "branch",
          "cond": "(!v.done)"
        },
        {
          "id": "next-or-restart_d0",
          "kind": "call",
          "target": "level",
          "method": "next",
          "args": []
        },
        {
          "id": "next-or-restart_e0",
          "kind": "call",
          "target": "level",
          "method": "restart",
          "args": []
        },
        {
          "id": "on-finish_on",
          "kind": "on",
          "event": "level.finished"
        },
        {
          "id": "on-finish_d0",
          "kind": "assign",
          "target": "done",
          "value": {
            "expr": "true"
          }
        },
        {
          "id": "on-finish_d1",
          "kind": "call",
          "target": "tuner1",
          "method": "stop",
          "args": []
        },
        {
          "id": "on-finish_d2",
          "kind": "call",
          "target": "feedback",
          "method": "show",
          "args": [
            "{text: '调音练习完成！得分 ' + v.score + ' 🎉', tone: 'info'}"
          ]
        },
        {
          "id": "on-finish_d3",
          "kind": "call",
          "target": "nextBtn",
          "method": "setText",
          "args": [
            "{text: '重新开始'}"
          ]
        },
        {
          "id": "on-finish_d4",
          "kind": "call",
          "target": "nextBtn",
          "method": "setEnabled",
          "args": [
            "{enabled: true}"
          ]
        }
      ],
      "edges": [
        {
          "id": "m1",
          "from": "load_d0",
          "to": "load_d1"
        },
        {
          "id": "m2",
          "from": "load_d1",
          "to": "load_d2"
        },
        {
          "id": "m3",
          "from": "load_on",
          "to": "load_d0"
        },
        {
          "id": "m4",
          "from": "in-tune_on",
          "to": "in-tune_cond"
        },
        {
          "id": "m5",
          "from": "in-tune_cond",
          "to": "in-tune_d0",
          "port": "true"
        },
        {
          "id": "m6",
          "from": "in-tune_cond",
