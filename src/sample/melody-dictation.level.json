{
  "schemaVersion": 1,
  "kind": "level",
  "id": "res_01J9A0A0A0A0A0A0A0A0A0A0A3",
  "version": "1.0.0",
  "meta": {
    "title": "旋律听写 · 键盘输入",
    "description": "听一段短旋律，在键盘上按顺序弹出它。演示序列播放（seq）、fingering 键盘输入与数组累加判定。",
    "author": {
      "name": "POC 内置示例"
    },
    "tags": [
      "练耳",
      "旋律",
      "键盘"
    ],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 3
  },
  "refs": [],
  "content": {
    "components": [
      {
        "id": "scoreLabel",
        "type": "label",
        "name": "得分",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 20,
          "w": 300,
          "h": 40
        },
        "props": {
          "text": "得分: 0"
        }
      },
      {
        "id": "feedback",
        "type": "label",
        "name": "反馈文本",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 90,
          "w": 720,
          "h": 48
        },
        "props": {
          "text": ""
        }
      },
      {
        "id": "keys1",
        "type": "fingering",
        "name": "答题键盘",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 160,
          "w": 720,
          "h": 180
        },
        "props": {
          "lowMidi": 60,
          "highMidi": 76
        }
      },
      {
        "id": "listenBtn",
        "type": "button",
        "name": "重听",
        "visible": true,
        "layout": {
          "x": 40,
          "y": 370,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "🔊 重听",
          "enabled": true
        }
      },
      {
        "id": "resetBtn",
        "type": "button",
        "name": "清空重输",
        "visible": true,
        "layout": {
          "x": 200,
          "y": 370,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "↺ 清空",
          "enabled": true
        }
      },
      {
        "id": "nextBtn",
        "type": "button",
        "name": "下一题",
        "visible": true,
        "layout": {
          "x": 620,
          "y": 370,
          "w": 140,
          "h": 48
        },
        "props": {
          "text": "下一题 →",
          "enabled": false
        }
      },
      {
        "id": "sound1",
        "type": "sound",
        "name": "发声器",
        "visible": false
      }
    ],
    "logic": {
      "variables": {
        "score": 0,
        "typed": [],
        "done": false
      },
      "rules": [
        {
          "id": "load-question",
          "on": "level.questionLoaded",
          "do": [
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.listenNotes",
                "mode": "seq",
                "tempo": 90
              }
            },
            {
              "cmd": "keys1.clear"
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": false
              }
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "听旋律，在键盘上按顺序弹出它",
                "tone": "info"
              }
            }
          ]
        },
        {
          "id": "replay",
          "on": "listenBtn.clicked",
          "do": [
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.listenNotes",
                "mode": "seq",
                "tempo": 90
              }
            }
          ]
        },
        {
          "id": "reset-input",
          "on": "resetBtn.clicked",
          "do": [
            {
              "set": "typed",
              "expr": "[]"
            },
            {
              "cmd": "keys1.clear"
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "已清空，重新输入",
                "tone": "info"
              }
            }
          ]
        },
        {
          "id": "collect-key",
          "on": "keys1.keyClicked",
          "do": [
            {
              "set": "typed",
              "expr": "append(v.typed, event.midi)"
            }
          ],
          "when": [
            "!v.answered"
          ]
        },
        {
          "id": "judge-when-full",
          "on": "keys1.keyClicked",
          "when": [
            "!v.answered",
            "len(v.typed) == len(q.data.answerSeq)"
          ],
          "do": [
            {
              "emit": "dict:judge"
            }
          ]
        },
        {
          "id": "judged",
          "on": "dict:judge",
          "when": [
            "!v.answered",
            "join(v.typed, ',') == join(q.data.answerSeq, ',')"
          ],
          "do": [
            {
              "set": "answered",
              "expr": "true"
            },
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.rewardChord",
                "mode": "seq",
                "tempo": 120
              }
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "完全正确！",
                "tone": "success"
              }
            },
            {
              "set": "score",
              "expr": "v.score + q.scoring.max"
            },
            {
              "cmd": "scoreLabel.show",
              "args": {
                "text": "$expr:'得分: ' + v.score",
                "tone": "success"
              }
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": true
              }
            }
          ],
          "else": [
            {
              "cmd": "sound1.play",
              "args": {
                "notes": "$q.data.wrongBuzz"
              }
            },
            {
              "cmd": "keys1.clear"
            },
            {
              "set": "typed",
              "expr": "[]"
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "顺序不对，点「🔊 重听」再试",
                "tone": "error"
              }
            }
          ]
        },
        {
          "id": "next-or-restart",
          "on": "nextBtn.clicked",
          "when": [
            "!v.done"
          ],
          "do": [
            {
              "cmd": "level.next"
            }
          ],
          "else": [
            {
              "cmd": "level.restart"
            }
          ]
        },
        {
          "id": "on-finish",
          "on": "level.finished",
          "when": [
            "event.passed"
          ],
          "do": [
            {
              "set": "done",
              "expr": "true"
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "$expr:'完成！得分 ' + v.score + ' 🎉 耳朵不错'",
                "tone": "success"
              }
            },
            {
              "cmd": "nextBtn.setText",
              "args": {
                "text": "重新开始"
              }
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": true
              }
            }
          ],
          "else": [
            {
              "set": "done",
              "expr": "true"
            },
            {
              "cmd": "feedback.show",
              "args": {
                "text": "$expr:'完成！得分 ' + v.score + '，再练一次'",
                "tone": "info"
              }
            },
            {
              "cmd": "nextBtn.setText",
              "args": {
                "text": "重新开始"
              }
            },
            {
              "cmd": "nextBtn.setEnabled",
              "args": {
                "enabled": true
              }
            }
          ]
        }
      ]
    },
    "questions": [
