{
  "schemaVersion": 3,
  "kind": "level",
  "id": "res_01J9C000000000000000000000",
  "version": "1.0.0",
  "meta": {
    "title": "新手引导 · 交互教程",
    "description": "5 个视图带你学会本平台关卡的全部交互：按钮、滑块、听音选答。对创作者而言，这也是 views.goto 视图切换的活示例。",
    "author": { "name": "POC 内置示例" },
    "tags": ["教程", "新手", "示例"],
    "locale": "zh-CN",
    "license": "CC0-1.0",
    "difficulty": 1
  },
  "refs": [],
  "content": {
    "views": [
      { "id": "welcome", "name": "欢迎", "template": false },
      { "id": "step1", "name": "第1步 · 按钮", "template": false },
      { "id": "step2", "name": "第2步 · 滑块", "template": false },
      { "id": "step3", "name": "第3步 · 听音", "template": false },
      { "id": "done", "name": "完成", "template": false }
    ],
    "components": [
      { "id": "t_label", "type": "label", "name": "欢迎标题", "visible": true, "view": "welcome", "layout": { "x": 40, "y": 30, "w": 560, "h": 46 }, "props": { "text": "🎵 欢迎来到音乐练习！", "tone": "info" } },
      { "id": "w_label", "type": "label", "name": "欢迎说明", "visible": true, "view": "welcome", "layout": { "x": 40, "y": 84, "w": 620, "h": 90 }, "props": { "text": "接下来 3 步，你会认识本平台关卡的全部交互：按钮、滑块、听音选答。\n随时可以点右上角「重开本关」从头来过。", "tone": "info" } },
      { "id": "start_btn", "type": "button", "name": "开始按钮", "visible": true, "view": "welcome", "layout": { "x": 40, "y": 190, "w": 160, "h": 44 }, "props": { "text": "开始 ▶", "enabled": true } },

      { "id": "s1_label", "type": "label", "name": "第1步说明", "visible": true, "view": "step1", "layout": { "x": 40, "y": 30, "w": 620, "h": 46 }, "props": { "text": "第 1 步 · 按钮：点击下面的按钮试试", "tone": "info" } },
      { "id": "try_btn", "type": "button", "name": "试练按钮", "visible": true, "view": "step1", "layout": { "x": 40, "y": 90, "w": 140, "h": 44 }, "props": { "text": "点我！", "enabled": true } },
      { "id": "s1_fb", "type": "label", "name": "第1步反馈", "visible": true, "view": "step1", "layout": { "x": 200, "y": 98, "w": 440, "h": 36 }, "props": { "text": "", "tone": "info" } },
      { "id": "s1_next", "type": "button", "name": "第1步下一步", "visible": true, "view": "step1", "layout": { "x": 40, "y": 150, "w": 160, "h": 44 }, "props": { "text": "下一步 ▶", "enabled": false } },

      { "id": "s2_label", "type": "label", "name": "第2步说明", "visible": true, "view": "step2", "layout": { "x": 40, "y": 30, "w": 640, "h": 46 }, "props": { "text": "第 2 步 · 滑块：拖动滑块，让数值正好变成 42", "tone": "info" } },
      { "id": "slider1", "type": "slider", "name": "练习滑块", "visible": true, "view": "step2", "layout": { "x": 40, "y": 96, "w": 420, "h": 40 }, "props": { "min": 0, "max": 100, "step": 1 } },
      { "id": "s2_fb", "type": "label", "name": "第2步反馈", "visible": true, "view": "step2", "layout": { "x": 40, "y": 146, "w": 560, "h": 36 }, "props": { "text": "", "tone": "info" } },
      { "id": "s2_next", "type": "button", "name": "第2步下一步", "visible": true, "view": "step2", "layout": { "x": 40, "y": 196, "w": 160, "h": 44 }, "props": { "text": "下一步 ▶", "enabled": false } },

      { "id": "s3_label", "type": "label", "name": "第3步说明", "visible": true, "view": "step3", "layout": { "x": 40, "y": 30, "w": 640, "h": 46 }, "props": { "text": "第 3 步 · 听音：播放一个音，选出它的唱名", "tone": "info" } },
      { "id": "play_btn", "type": "button", "name": "播放按钮", "visible": true, "view": "step3", "layout": { "x": 40, "y": 92, "w": 140, "h": 44 }, "props": { "text": "🔊 播放", "enabled": true } },
      { "id": "choice1", "type": "choice", "name": "唱名选择", "visible": true, "view": "step3", "layout": { "x": 40, "y": 150, "w": 420, "h": 120 }, "props": {}, "bindings": { "options": "$q.data.options" } },
      { "id": "s3_fb", "type": "label", "name": "第3步反馈", "visible": true, "view": "step3", "layout": { "x": 480, "y": 158, "w": 220, "h": 36 }, "props": { "text": "", "tone": "info" } },
      { "id": "s3_next", "type": "button", "name": "完成按钮", "visible": true, "view": "step3", "layout": { "x": 40, "y": 286, "w": 160, "h": 44 }, "props": { "text": "完成 ▶", "enabled": false } },

      { "id": "done_label", "type": "label", "name": "完成标题", "visible": true, "view": "done", "layout": { "x": 40, "y": 40, "w": 560, "h": 46 }, "props": { "text": "🎉 教程完成！", "tone": "success" } },
      { "id": "score_label", "type": "label", "name": "得分展示", "visible": true, "view": "done", "layout": { "x": 40, "y": 96, "w": 400, "h": 36 }, "props": { "text": "得分: 0", "tone": "info" } },
      { "id": "again_btn", "type": "button", "name": "重学按钮", "visible": true, "view": "done", "layout": { "x": 40, "y": 150, "w": 160, "h": 44 }, "props": { "text": "再学一遍", "enabled": true } },

      { "id": "synth1", "type": "synth", "name": "音效合成器", "visible": false, "view": "step3", "layout": { "x": 480, "y": 200, "w": 180, "h": 90 }, "props": { "wave": "triangle", "gain": 0.4 } }
    ],
    "logic": {
      "logicVersion": 2,
      "variables": { "score": 0 },
      "nodes": [
        { "id": "on_start", "kind": "on", "event": "start_btn.clicked", "x": 0, "y": 0 },
        { "id": "goto_step1", "kind": "call", "target": "views", "method": "goto", "args": ["{id: 'step1'}"], "x": 260, "y": 0 },

        { "id": "on_try", "kind": "on", "event": "try_btn.clicked", "x": 0, "y": 120 },
        { "id": "fb1", "kind": "call", "target": "s1_fb", "method": "show", "args": ["{text: '✅ 很好！刚才的事件就是「按钮事件」——点击会触发一条逻辑链', tone: 'success'}"], "x": 260, "y": 120 },
        { "id": "en1", "kind": "call", "target": "s1_next", "method": "setEnabled", "args": ["{enabled: true}"], "x": 520, "y": 120 },

        { "id": "on_s1next", "kind": "on", "event": "s1_next.clicked", "x": 0, "y": 240 },
        { "id": "goto_step2", "kind": "call", "target": "views", "method": "goto", "args": ["{id: 'step2'}"], "x": 260, "y": 240 },

        { "id": "on_slider", "kind": "on", "event": "slider1.changed", "x": 0, "y": 360 },
        { "id": "fb2a", "kind": "call", "target": "s2_fb", "method": "show", "args": ["{text: '滑块当前值: ' + event.value}"], "x": 260, "y": 360 },
        { "id": "br42", "kind": "branch", "cond": "event.value == 42", "x": 520, "y": 360 },
        { "id": "fb2b", "kind": "call", "target": "s2_fb", "method": "show", "args": ["{text: '✅ 就是 42！可以进入下一步了', tone: 'success'}"], "x": 780, "y": 300 },
        { "id": "en2", "kind": "call", "target": "s2_next", "method": "setEnabled", "args": ["{enabled: true}"], "x": 1040, "y": 300 },

        { "id": "on_s2next", "kind": "on", "event": "s2_next.clicked", "x": 0, "y": 480 },
        { "id": "goto_step3", "kind": "call", "target": "views", "method": "goto", "args": ["{id: 'step3'}"], "x": 260, "y": 480 },

        { "id": "on_play", "kind": "on", "event": "play_btn.clicked", "x": 0, "y": 600 },
        { "id": "synthplay", "kind": "call", "target": "synth1", "method": "play", "args": ["{notes: q.data.notes, wave: 'triangle', mode: 'seq', tempo: 100}"], "x": 260, "y": 600 },

        { "id": "on_choose", "kind": "on", "event": "choice1.chosen", "x": 0, "y": 720 },
        { "id": "brans", "kind": "branch", "cond": "event.value == q.data.answer", "x": 260, "y": 720 },
        { "id": "fb3ok", "kind": "call", "target": "s3_fb", "method": "show", "args": ["{text: '✅ 答对了！这是 Mi', tone: 'success'}"], "x": 520, "y": 660 },
        { "id": "addscore", "kind": "assign", "target": "score", "value": { "expr": "v.score + q.scoring.max" }, "x": 780, "y": 660 },
        { "id": "en3", "kind": "call", "target": "s3_next", "method": "setEnabled", "args": ["{enabled: true}"], "x": 1040, "y": 660 },
        { "id": "fb3no", "kind": "call", "target": "s3_fb", "method": "show", "args": ["{text: '❌ 不是这个——再听一次试试', tone: 'error'}"], "x": 520, "y": 780 },

        { "id": "on_s3next", "kind": "on", "event": "s3_next.clicked", "x": 0, "y": 840 },
        { "id": "finish", "kind": "call", "target": "level", "method": "finish", "args": [], "x": 260, "y": 840 },

        { "id": "on_finished", "kind": "on", "event": "level.finished", "x": 0, "y": 960 },
        { "id": "score_show", "kind": "call", "target": "score_label", "method": "show", "args": ["{text: '最终得分: ' + v.score}"], "x": 260, "y": 960 },
        { "id": "goto_done", "kind": "call", "target": "views", "method": "goto", "args": ["{id: 'done'}"], "x": 520, "y": 960 },

        { "id": "on_again", "kind": "on", "event": "again_btn.clicked", "x": 0, "y": 1080 },
        { "id": "restart", "kind": "call", "target": "level", "method": "restart", "args": [], "x": 260, "y": 1080 }
      ],
      "edges": [
        { "id": "e1", "from": "on_start", "to": "goto_step1" },
        { "id": "e2", "from": "on_try", "to": "fb1" },
        { "id": "e3", "from": "fb1", "to": "en1" },
        { "id": "e4", "from": "on_s1next", "to": "goto_step2" },
        { "id": "e5", "from": "on_slider", "to": "fb2a" },
        { "id": "e6", "from": "fb2a", "to": "br42" },
        { "id": "e7", "from": "br42", "to": "fb2b", "port": "true" },
        { "id": "e8", "from": "fb2b", "to": "en2" },
        { "id": "e9", "from": "on_s2next", "to": "goto_step3" },
        { "id": "e10", "from": "on_play", "to": "synthplay" },
        { "id": "e11", "from": "on_choose", "to": "brans" },
        { "id": "e12", "from": "brans", "to": "fb3ok", "port": "true" },
        { "id": "e13", "from": "fb3ok", "to": "addscore" },
        { "id": "e14", "from": "addscore", "to": "en3" },
        { "id": "e15", "from": "brans", "to": "fb3no", "port": "false" },
        { "id": "e16", "from": "on_s3next", "to": "finish" },
        { "id": "e17", "from": "on_finished", "to": "score_show" },
        { "id": "e18", "from": "score_show", "to": "goto_done" },
        { "id": "e19", "from": "on_again", "to": "restart" }
      ]
    },
    "table": {
      "columns": [
        { "key": "data", "label": "数据" },
        { "key": "scoring", "label": "分值" }
      ],
      "rows": [
        { "data": { "options": ["Do", "Re", "Mi"], "answer": "Mi", "notes": [{ "midi": 64, "dur": "2n" }] }, "scoring": { "max": 10 } }
      ]
    },
    "flow": { "order": "sequential", "pass": { "expr": "v.score >= 10" } }
  }
}
