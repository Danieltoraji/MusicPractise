              },
              "props": {
                "text": "下一步 ▶"
              }
            }
          ]
        },
        "behavior": {
          "logicVersion": 3,
          "kind": "behavior",
          "nodes": [
            {
              "id": "b_onStart",
              "kind": "on",
              "event": "start"
            },
            {
              "id": "b_start_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_start_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onChange",
              "kind": "on",
              "event": "slider1.changed"
            },
            {
              "id": "b_store",
              "kind": "assign",
              "target": "q.state.value",
              "value": {
                "expr": "event.payload.value"
              }
            },
            {
              "id": "b_count",
              "kind": "assign",
              "target": "t.changes",
              "value": {
                "expr": "t.changes + 1"
              }
            },
            {
              "id": "b_feedback",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '当前值：' + event.payload.value, tone: 'info' }"
            },
            {
              "id": "b_change_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_change_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0 }"
            },
            {
              "id": "b_onNext",
              "kind": "on",
              "event": "nextBtn.clicked"
            },
            {
              "id": "b_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: 0, payload: { value: q.state.value } }"
            },
            {
              "id": "b_comment",
              "kind": "comment",
              "text": "手动推进：滑块只记录 q.state.value，由「下一步」返回 payload"
            }
