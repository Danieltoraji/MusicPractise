        "behavior": {
          "logicVersion": 3,
          "kind": "behavior",
          "nodes": [
            {
              "id": "b_onStart",
              "kind": "on",
              "event": "start"
            },
            {
              "id": "b_setOptions",
              "kind": "call",
              "target": "choice1",
              "method": "setOptions",
              "arg": "{ options: q.options }"
            },
            {
              "id": "b_countAsk",
              "kind": "assign",
              "target": "t.asked",
              "value": {
                "expr": "t.asked + 1"
              }
            },
            {
              "id": "b_playListen",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_start_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_start_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring + args.bonus }"
            },
            {
              "id": "b_onReplay",
              "kind": "on",
              "event": "listenBtn.clicked"
            },
            {
              "id": "b_playReplay",
              "kind": "call",
              "target": "sound1",
              "method": "play",
              "arg": "{ notes: q.listenNotes }"
            },
            {
              "id": "b_replay_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_replay_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring + args.bonus }"
            },
            {
              "id": "b_onChosen",
              "kind": "on",
              "event": "choice1.chosen"
            },
            {
              "id": "b_chosen_guard",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_chosen_guard_ret",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring + args.bonus }"
            },
            {
              "id": "b_isCorrect",
              "kind": "branch",
              "cond": "event.payload.index == q.answerIndex"
            },
            {
              "id": "b_markAnswered",
              "kind": "assign",
              "target": "q.state.answered",
              "value": {
                "expr": "true"
              }
            },
            {
              "id": "b_reveal",
              "kind": "call",
              "target": "choice1",
              "method": "reveal",
              "arg": "{ correctIndex: q.answerIndex }"
            },
            {
              "id": "b_feedbackOk",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '答对了！点「下一题」继续。', tone: 'success' }"
            },
            {
              "id": "b_feedbackBad",
              "kind": "call",
              "target": "feedback",
              "method": "show",
              "arg": "{ text: '不是这个，再听一遍。', tone: 'error' }"
            },
            {
              "id": "b_onNext",
              "kind": "on",
              "event": "nextBtn.clicked"
            },
            {
              "id": "b_next_next",
              "kind": "branch",
              "cond": "q.state.answered"
            },
            {
              "id": "b_next_next_scored",
              "kind": "return",
              "result": "{ status: 'answered', correct: true, scoreDelta: q.scoring + args.bonus }"
            },
            {
              "id": "b_next_next_skipped",
              "kind": "return",
              "result": "{ status: 'skipped', correct: false, scoreDelta: 0 }"
            },
            {
              "id": "b_comment",
              "kind": "comment",
              "text": "首次答对计分（answered 守卫）；答错只给反馈，可重听重选；下一题收题"
