        {
          "id": "track-streak_on",
          "kind": "on",
          "event": "level:correct"
        },
        {
          "id": "track-streak_d0",
          "kind": "assign",
          "target": "streak",
          "value": {
            "expr": "v.streak + 1"
          }
        },
        {
          "id": "next-or-restart_on",
          "kind": "on",
          "event": "nextBtn.clicked"
        },
        {
          "id": "next-or-restart_cond",
          "kind": "branch",
          "cond": "(!v.done)"
        },
        {
          "id": "next-or-restart_d0",
          "kind": "call",
          "target": "level",
          "method": "next",
          "args": []
        },
        {
          "id": "next-or-restart_e0",
          "kind": "call",
          "target": "level",
          "method": "restart",
          "args": []
        },
        {
          "id": "on-finish_on",
          "kind": "on",
          "event": "level.finished"
        },
        {
          "id": "on-finish_cond",
          "kind": "branch",
          "cond": "(event.passed)"
        },
        {
          "id": "on-finish_d0",
          "kind": "assign",
          "target": "done",
          "value": {
            "expr": "true"
          }
        },
