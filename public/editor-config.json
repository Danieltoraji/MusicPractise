{
  "meta": { "title": "编辑器新建 · 测试关" },
  "content": {
    "components": [
      { "id": "scoreLabel", "type": "label", "name": "得分", "visible": true, "layout": { "x": 40, "y": 20, "w": 300, "h": 40 }, "props": { "text": "得分: 0" } },
      { "id": "staff1", "type": "staff", "name": "谱面", "visible": true, "layout": { "x": 40, "y": 90, "w": 720, "h": 180 }, "props": { "clef": "treble", "clickable": true }, "bindings": { "music": "$q.data.music" } },
      { "id": "feedback", "type": "label", "name": "反馈", "visible": true, "layout": { "x": 40, "y": 300, "w": 720, "h": 48 }, "props": { "text": "听音后点击谱面上对应的音符" } },
      { "id": "listenBtn", "type": "button", "name": "听", "visible": true, "layout": { "x": 40, "y": 380, "w": 140, "h": 48 }, "props": { "text": "🔊 听", "enabled": true } },
      { "id": "nextBtn", "type": "button", "name": "下一题", "visible": true, "layout": { "x": 620, "y": 380, "w": 140, "h": 48 }, "props": { "text": "下一题 →", "enabled": false } },
      { "id": "sound1", "type": "sound", "name": "发声器", "visible": false }
    ],
    "logic": {
      "variables": { "score": 0, "done": false },
      "rules": [
        {
          "id": "load",
          "on": "level.questionLoaded",
          "do": [
            { "cmd": "sound1.play", "args": { "notes": "$q.data.listenNotes" } },
            { "cmd": "staff1.clear" },
            { "cmd": "nextBtn.setEnabled", "args": { "enabled": false } },
            { "cmd": "feedback.show", "args": { "text": "听 —— 点击对应的音符", "tone": "info" } }
          ]
        },
        {
          "id": "replay",
          "on": "listenBtn.clicked",
          "do": [{ "cmd": "sound1.play", "args": { "notes": "$q.data.listenNotes" } }]
        },
        {
          "id": "check",
          "on": "staff1.noteClicked",
          "when": ["event.midi == q.data.answerMidi"],
          "do": [
            { "cmd": "sound1.play", "args": { "notes": "$q.data.rewardChord" } },
            { "cmd": "staff1.highlight", "args": { "target": "$event.midi", "style": "correct" } },
            { "cmd": "feedback.show", "args": { "text": "答对了！", "tone": "success" } },
            { "set": "score", "expr": "v.score + q.scoring.max" },
            { "cmd": "scoreLabel.show", "args": { "text": "$expr:'得分: ' + v.score", "tone": "success" } },
            { "cmd": "nextBtn.setEnabled", "args": { "enabled": true } }
          ],
          "else": [
            { "cmd": "feedback.show", "args": { "text": "不对哦，再听一次", "tone": "error" } }
          ]
        },
        {
          "id": "next",
          "on": "nextBtn.clicked",
          "when": ["!v.done"],
          "do": [{ "cmd": "level.next" }],
          "else": [{ "cmd": "level.restart" }]
        },
        {
          "id": "finish",
          "on": "level.finished",
          "do": [
            { "set": "done", "expr": "true" },
            { "cmd": "feedback.show", "args": { "text": "$expr:event.passed ? '完成！得分 ' + v.score + ' 🎉' : '完成！得分 ' + v.score", "tone": "info" } },
            { "cmd": "nextBtn.setText", "args": { "text": "重新开始" } },
            { "cmd": "nextBtn.setEnabled", "args": { "enabled": true } }
          ]
        }
      ]
    },
    "questions": [
      {
        "id": "q1",
        "prompt": { "text": "听 —— 点击你听到的音" },
        "data": {
          "music": { "notes": [{ "midi": 60 }, { "midi": 62 }, { "midi": 64 }, { "midi": 65 }], "clef": "treble" },
          "listenNotes": [{ "midi": 64, "dur": "2n" }],
          "answerMidi": 64,
          "rewardChord": [{ "midi": 60 }, { "midi": 64 }, { "midi": 67 }],
          "wrongBuzz": [{ "midi": 43, "dur": "8n" }]
        },
        "scoring": { "max": 10 }
      },
      {
        "id": "q2",
        "prompt": { "text": "听 —— 点击你听到的那个音" },
        "data": {
          "music": { "notes": [{ "midi": 67 }, { "midi": 69 }, { "midi": 71 }, { "midi": 72 }], "clef": "treble" },
          "listenNotes": [{ "midi": 71, "dur": "2n" }],
          "answerMidi": 71,
          "rewardChord": [{ "midi": 67 }, { "midi": 71 }],
          "wrongBuzz": [{ "midi": 43, "dur": "8n" }]
        },
        "scoring": { "max": 10 }
      }
    ],
    "flow": { "order": "sequential", "pass": { "expr": "v.score >= 20" } }
  }
}
